{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Partisipasi Sekolah",
  "version": "0.1.0",
  "identifier": "me.ppti.partisipasi-sekolah",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Partisipasi Sekolah",
        "width": 1200,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "icons/Square150x150Logo.png",
        "sidebarImage": "icons/Square310x310Logo.png",
        "installerIcon": "icons/icon.ico",
        "installMode": "both"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "partisipasi-sekolah"
        ]
      }
    }
  }
}
