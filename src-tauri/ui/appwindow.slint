import { Theme } from "theme.slint";
import { Sidebar } from "components/sidebar.slint";
import { Header } from "components/header.slint";
import { LoginView } from "views/login_view.slint";
import { WizardView } from "views/wizard_view.slint";
import { PosView, StudentData, BillSummaryData, AssignmentData, CartItemData, TodayPaymentData } from "views/pos_view.slint";
import { SavingsView, SavingsHistoryData } from "views/savings_view.slint";
import { HistoryView, HistoryRecord } from "views/history_view.slint";
import { ReportsView, CashierSummaryRecord } from "views/reports_view.slint";
import { SyncView } from "views/sync_view.slint";

export struct StudentSearchResult {
    id: string,
    nama: string,
    nis: string,
    nisn: string,
    kelas: string,
    is_active: bool,
}

export struct ReceiptModalItem {
    index: int,
    description: string,
    amount: string,
}

export struct ReceiptModalData {
    transaction_code: string,
    created_at: string,
    receipt_date: string,
    student_name: string,
    student_nis: string,
    student_class: string,
    payment_method: string,
    total_amount: string,
    cashier_name: string,
    notes: string,
    committee_name: string,
    school_name: string,
    school_address: string,
    has_stamp: bool,
}

export component AppWindow inherits Window {
    title: root.window-title;
    preferred-width: 1200px;
    preferred-height: 760px;
    min-width: 960px;
    min-height: 640px;
    background: Theme.bg-primary;

    // Window Branding & Feature Flags
    in property <string> window-title: "Partisipasi Sekolah Desktop v0.2.0";
    in property <bool> savings-enabled: false;
    in property <bool> has-school-logo: false;
    in property <image> school-logo;

    // Kamus Istilah & Nomenklatur Dinamis (Paritas Web)
    in property <string> term-pembayaran: "Pembayaran";
    in property <string> term-pembayaran-upper: "PEMBAYARAN";
    in property <string> term-pembayaran-lower: "pembayaran";
    in property <string> term-tagihan: "Tagihan";
    in property <string> term-tagihan-lower: "tagihan";
    in property <string> term-siswa: "Siswa";
    in property <string> term-siswa-lower: "siswa";
    in property <string> term-kwitansi: "Kwitansi";
    in property <string> term-kwitansi-upper: "KWITANSI";
    in property <string> term-tunggakan: "Tunggakan";

    // Navigation & Auth State
    in-out property <bool> is-logged-in: false;
    in-out property <string> login-error: "";
    in property <bool> has-offline-pin: true;
    in property <string> api-endpoint-url: "https://sekolah.id";
    in-out property <int> active-tab: 0;
    in property <string> user-name: "Kasir Loket 1";
    in property <string> user-role: "Petugas Kasir";
    in property <bool> is-online: false;
    in property <string> pending-sync-count: "0";
    in property <string> active-academic-year: "2024/2025";
    in property <bool> is-syncing: false;

    // Search state
    in-out property <string> search-query: "";
    in-out property <bool> show-search-results: false;
    in-out property <int> student-filter-status: 0;
    in property <[StudentSearchResult]> search-results: [];

    // Kasir Dashboard Summary State
    in property <string> today-cashier-total: "Rp 0";
    in property <string> monthly-cashier-total: "Rp 0";
    in property <string> today-cashier-count: "0 Transaksi";

    // POS State
    in property <StudentData> current-student: {
        id: "",
        nis: "-",
        nisn: "-",
        nama: "",
        kelas: "-",
        savings_balance: "Rp 0"
    };
    in property <BillSummaryData> bill-summary: {
        total_tagihan: "Rp 0",
        total_dibayar: "Rp 0",
        total_keringanan: "Rp 0",
        total_tunggakan: "Rp 0"
    };
    in property <[AssignmentData]> assignments: [];
    in property <[CartItemData]> cart-items: [];
    in property <[TodayPaymentData]> today-payments: [];
    in property <string> cart-total: "Rp 0";
    in property <int> selected-payment-method: 0;
    in property <bool> is-processing-payment: false;
    in-out property <string> cashier-notes: "";

    // Savings State
    in property <[SavingsHistoryData]> savings-history: [];
    in property <bool> is-processing-savings: false;

    // History State
    in property <[HistoryRecord]> history-records: [];

    // Reports State
    in property <string> grand-total: "Rp 0";
    in property <string> cash-total: "Rp 0";
    in property <string> transfer-total: "Rp 0";
    in property <string> savings-total: "Rp 0";
    in property <[CashierSummaryRecord]> cashier-summaries: [];

    // Sync State
    in-out property <string> sync-base-url: "https://";
    in-out property <string> sync-api-token: "";
    in property <string> sync-last-time: "Belum pernah sinkron";
    in property <string> sync-pending-count: "0";
    in property <string> sync-message: "";
    in property <bool> is-testing-connection: false;
    in property <string> test-connection-result: "";
    in-out property <string> sync-toast-message: "";
    in property <bool> sync-toast-is-error: false;
    in-out property <bool> autostart-enabled: false;

    // Fresh Install / Setup Wizard State
    in-out property <bool> is-fresh-install: false;
    in property <bool> is-testing-wizard: false;
    in property <string> wizard-test-message: "";
    in property <bool> wizard-test-success: false;

    // About & Update Modal State
    in-out property <bool> show-about-modal: false;
    in-out property <string> update-status-text: "";
    in-out property <bool> is-checking-update: false;

    // In-App Receipt Modal State
    in-out property <bool> show-receipt-modal: false;
    in property <ReceiptModalData> receipt-modal-data;
    in property <[ReceiptModalItem]> receipt-modal-items: [];
    in property <bool> has-receipt-stamp: false;
    in property <image> receipt-stamp-image;

    // Callbacks to Rust Controller
    callback tab-changed(int);
    callback search-changed(string);
    callback student-filter-changed(int);
    callback student-selected(string);
    callback clear-student();
    callback toggle-assignment(string);
    callback toggle-year-collapse(string);
    callback remove-cart(string);
    callback set-payment-method(int);
    callback process-payment();
    callback trigger-sync();
    callback trigger-full-sync();
    callback deposit-savings(string, string);
    callback withdraw-savings(string, string);
    callback refresh-history();
    callback history-search-changed(string);
    callback refresh-reports();
    callback print-receipt(string);
    callback execute-direct-print(string);
    callback close-receipt-modal();
    callback test-sync-connection(string);
    callback save-sync-settings(string);
    callback toggle-autostart-clicked();
    callback test-wizard-connection(string);
    callback finish-wizard(string);
    callback check-for-updates();
    callback save-server-url(string);
    callback sso-login();
    callback code-login(string);
    callback pin-login(string);
    callback logout();

    // -1. Setup Wizard Onboarding (Bila instalasi awal pertama kali)
    if root.is-fresh-install: WizardView {
        api-url: root.api-endpoint-url;
        is-testing: root.is-testing-wizard;
        test-message: root.wizard-test-message;
        test-success: root.wizard-test-success;
        test-connection-clicked(u) => { root.test-wizard-connection(u); }
        finish-onboarding(u) => { root.finish-wizard(u); }
    }

    // 0. Layar Masuk / Login View (Bila sesi kasir belum aktif dan bukan instalasi awal)
    if !root.is-fresh-install && !root.is-logged-in: LoginView {
        api-url: root.api-endpoint-url;
        has-offline-pin: root.has-offline-pin;
        error-message: root.login-error;
        sso-login-clicked => { root.sso-login(); }
        code-login-submitted(c) => { root.code-login(c); }
        pin-login-submitted(p) => { root.pin-login(p); }
        save-server-url(u) => { root.save-server-url(u); }
    }

    // 1. Terminal Kasir Utama (Bila kasir sudah masuk / terautentikasi dan bukan fresh install)
    if !root.is-fresh-install && root.is-logged-in: HorizontalLayout {
        // 1. Sidebar Navigasi Kiri (260px)
        Sidebar {
            active-tab: root.active-tab;
            user-name: root.user-name;
            user-role: root.user-role;
            is-online: root.is-online;
            pending-sync-count: root.pending-sync-count;
            savings-enabled: root.savings-enabled;
            has-school-logo: root.has-school-logo;
            school-logo: root.school-logo;
            tab-selected(idx) => {
                root.active-tab = idx;
                root.tab-changed(idx);
            }
            logout-clicked => {
                root.logout();
            }
        }

        // 2. Main Content Right Panel (Header + Active View)
        VerticalLayout {
            horizontal-stretch: 1;

            // Header Atas (70px)
            Header {
                search-query <=> root.search-query;
                active-academic-year: root.active-academic-year;
                is-syncing: root.is-syncing;
                student-filter-status <=> root.student-filter-status;
                term-siswa: root.term-siswa;
                student-filter-changed(st) => {
                    root.student-filter-changed(st);
                }
                search-changed(q) => {
                    root.search-changed(q);
                }
                search-submitted(q) => {
                    root.search-changed(q);
                }
                trigger-sync-clicked => {
                    root.trigger-sync();
                }
                about-clicked => {
                    root.show-about-modal = true;
                }
            }

            // View Stack Container
            Rectangle {
                vertical-stretch: 1;
                background: Theme.bg-primary;

                if root.active-tab == 0: PosView {
                    today-cashier-total: root.today-cashier-total;
                    monthly-cashier-total: root.monthly-cashier-total;
                    today-cashier-count: root.today-cashier-count;
                    current-student: root.current-student;
                    summary: root.bill-summary;
                    assignments: root.assignments;
                    cart-items: root.cart-items;
                    today-payments: root.today-payments;
                    cart-total: root.cart-total;
                    selected-payment-method: root.selected-payment-method;
                    is-processing-payment: root.is-processing-payment;
                    savings-enabled: root.savings-enabled;
                    cashier-notes <=> root.cashier-notes;
                    term-pembayaran: root.term-pembayaran;
                    term-pembayaran-upper: root.term-pembayaran-upper;
                    term-pembayaran-lower: root.term-pembayaran-lower;
                    term-tagihan: root.term-tagihan;
                    term-tagihan-lower: root.term-tagihan-lower;
                    term-siswa: root.term-siswa;
                    term-siswa-lower: root.term-siswa-lower;
                    term-kwitansi: root.term-kwitansi;
                    term-tunggakan: root.term-tunggakan;

                    toggle-assignment-selection(id) => { root.toggle-assignment(id); }
                    remove-cart-item(id) => { root.remove-cart(id); }
                    select-payment-method(m) => { root.set-payment-method(m); }
                    process-payment-clicked => { root.process-payment(); }
                    print-receipt-clicked(code) => { root.print-receipt(code); }
                    clear-selected-student => { root.clear-student(); }
                    toggle-year-collapse(name) => { root.toggle-year-collapse(name); }
                }

                if root.active-tab == 1: SavingsView {
                    student-name: root.current-student.nama;
                    student-class: root.current-student.kelas;
                    current-balance: root.current-student.savings_balance;
                    history: root.savings-history;
                    is-processing: root.is-processing-savings;
                    term-pembayaran: root.term-pembayaran;
                    term-pembayaran-lower: root.term-pembayaran-lower;
                    term-siswa: root.term-siswa;
                    term-siswa-lower: root.term-siswa-lower;

                    deposit-clicked(amt, note) => { root.deposit-savings(amt, note); }
                    withdraw-clicked(amt, note) => { root.withdraw-savings(amt, note); }
                }

                if root.active-tab == 2: HistoryView {
                    records: root.history-records;
                    term-pembayaran: root.term-pembayaran;
                    term-siswa: root.term-siswa;
                    term-siswa-lower: root.term-siswa-lower;
                    refresh-clicked => { root.refresh-history(); }
                    search-changed(q) => { root.history-search-changed(q); }
                    print-receipt(code) => { root.print-receipt(code); }
                }

                if root.active-tab == 3: ReportsView {
                    grand-total: root.grand-total;
                    cash-total: root.cash-total;
                    transfer-total: root.transfer-total;
                    savings-total: root.savings-total;
                    cashier-summaries: root.cashier-summaries;
                    refresh-reports => { root.refresh-reports(); }
                }

                if root.active-tab == 4: SyncView {
                    base-url <=> root.sync-base-url;
                    user-name: root.user-name;
                    user-role: root.user-role;
                    is-authenticated: root.is-logged-in;
                    autostart-enabled: root.autostart-enabled;
                    last-sync-time: root.sync-last-time;
                    pending-records-count: root.sync-pending-count;
                    sync-message: root.sync-message;
                    is-syncing: root.is-syncing;
                    is-testing: root.is-testing-connection;
                    test-result: root.test-connection-result;

                    test-connection-clicked(url) => { root.test-sync-connection(url); }
                    save-settings-clicked(url) => { root.save-sync-settings(url); }
                    trigger-sync-clicked => { root.trigger-sync(); }
                    trigger-full-sync-clicked => { root.trigger-full-sync(); }
                    toggle-autostart-clicked => { root.toggle-autostart-clicked(); }
                }

                // Toast Feedback Sinkronisasi Floating
                if root.sync-toast-message != "": Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 10px;
                    z: 90;
                    height: 38px;
                    border-radius: 19px;
                    background: root.sync-toast-is-error ? #fef2f2 : #ecfdf5;
                    border-color: root.sync-toast-is-error ? #fca5a5 : #a7f3d0;
                    border-width: 1px;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: #00000018;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 10px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            width: 16px;
                            Image {
                                source: root.sync-toast-is-error ? @image-url("assets/icons/lock.svg") : @image-url("assets/icons/sync.svg");
                                width: 14px;
                                height: 14px;
                                image-fit: contain;
                                colorize: root.sync-toast-is-error ? #dc2626 : #059669;
                            }
                        }

                        Text {
                            text: root.sync-toast-message;
                            font-size: 12px;
                            font-weight: 700;
                            color: root.sync-toast-is-error ? #b91c1c : #047857;
                            vertical-alignment: center;
                        }

                        // Tombol Silang / Dismiss Banner
                        VerticalLayout {
                            alignment: center;
                            width: 20px;
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 10px;
                                background: touch-toast-dismiss.has-hover ? (root.sync-toast-is-error ? #fee2e2 : #d1fae5) : transparent;
                                animate background { duration: 150ms; }
                                touch-toast-dismiss := TouchArea {
                                    clicked => { root.sync-toast-message = ""; }
                                    mouse-cursor: pointer;
                                }
                                Image {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    source: @image-url("assets/icons/close.svg");
                                    width: 9px;
                                    height: 9px;
                                    image-fit: contain;
                                    colorize: root.sync-toast-is-error ? #b91c1c : #047857;
                                }
                            }
                        }
                    }
                }

                // Search Results Dropdown Dismiss Backdrop
                if root.show-search-results: TouchArea {
                    clicked => { root.show-search-results = false; }
                }

                // Search Results Dropdown Popup (bila ada hasil search)
                if root.show-search-results: Rectangle {
                    x: 232px;
                    y: 6px;
                    width: 550px;
                    height: root.search-results.length == 0 ? 84px : Math.min(320px, 46px + root.search-results.length * 52px);
                    background: Theme.bg-card;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 8px;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: #00000020;

                    VerticalLayout {
                        width: 100%;
                        alignment: start;
                        padding: 10px;
                        spacing: 6px;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: space-between;
                            Text {
                                text: root.student-filter-status == 0 ? ("Hasil Pencarian " + root.term-siswa + " Aktif:") : ("Hasil Pencarian " + root.term-siswa + " Non-Aktif / Alumni:");
                                font-size: 11px;
                                font-weight: 700;
                                color: Theme.text-muted;
                            }
                            Text {
                                text: "Klik baris " + root.term-siswa-lower + " untuk memilih";
                                font-size: 11px;
                                color: Theme.primary;
                            }
                        }

                        Rectangle { height: 1px; background: Theme.border; }

                        if root.search-results.length == 0: Rectangle {
                            height: 36px;
                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: "Tidak ada " + root.term-siswa-lower + " ditemukan.";
                                    font-size: 12px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if root.search-results.length > 0: Flickable {
                            width: 100%;
                            vertical-stretch: 1;
                            content-height: root.search-results.length * 52px;
                            VerticalLayout {
                                width: 100%;
                                alignment: start;
                                spacing: 4px;
                                for res in root.search-results: Rectangle {
                                    width: 100%;
                                    height: 48px;
                                    background: touch-res.has-hover ? #eff6ff : Theme.bg-secondary;
                                    border-radius: 6px;
                                    animate background { duration: 150ms; }

                                    touch-res := TouchArea {
                                        clicked => {
                                            root.student-selected(res.id);
                                        }
                                        mouse-cursor: pointer;
                                    }

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 14px;
                                        spacing: 10px;

                                        VerticalLayout {
                                            alignment: center;
                                            width: 28px;
                                            Rectangle {
                                                width: 28px;
                                                height: 28px;
                                                background: Theme.primary-light;
                                                border-radius: 14px;
                                                Image {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    source: @image-url("assets/icons/student.svg");
                                                    width: 14px;
                                                    height: 14px;
                                                    image-fit: contain;
                                                    colorize: Theme.primary;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: res.nama;
                                                font-size: 13px;
                                                font-weight: 700;
                                                color: Theme.text-main;
                                                horizontal-alignment: left;
                                                overflow: elide;
                                            }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: start;
                                                Text {
                                                    text: "NIS: " + res.nis + " | Kelas: " + res.kelas;
                                                    font-size: 11px;
                                                    color: Theme.text-muted;
                                                    horizontal-alignment: left;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                                if !res.is_active: Rectangle {
                                                    height: 16px;
                                                    background: #fef2f2;
                                                    border-color: #fca5a5;
                                                    border-width: 1px;
                                                    border-radius: 3px;
                                                    HorizontalLayout {
                                                        padding-left: 4px;
                                                        padding-right: 4px;
                                                        Text {
                                                            text: "Non-Aktif";
                                                            font-size: 9px;
                                                            font-weight: 700;
                                                            color: #dc2626;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            width: 64px;
                                            Rectangle {
                                                width: 64px;
                                                height: 28px;
                                                background: touch-res.has-hover ? Theme.primary-hover : Theme.primary;
                                                border-radius: 4px;
                                                animate background { duration: 150ms; }
                                                HorizontalLayout {
                                                    alignment: center;
                                                    Text {
                                                        text: "Pilih";
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        color: white;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal Pratinjau & Cetak Kwitansi (In-App Receipt Modal)
    if root.show-receipt-modal: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #00000055;
        z: 100;

        // Dialog Card
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 540px;
            height: 640px;
            background: #ffffff;
            border-radius: 12px;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000040;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                // Modal Header
                HorizontalLayout {
                    height: 28px;
                    alignment: space-between;

                    Text {
                        text: root.term-kwitansi + " " + root.term-pembayaran + " Kasir";
                        font-size: 15px;
                        font-weight: 800;
                        color: Theme.primary;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        background: touch-close-m.has-hover ? #fee2e2 : #f1f5f9;
                        border-radius: 14px;
                        animate background { duration: 150ms; }
                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: @image-url("assets/icons/close.svg");
                            width: 12px;
                            height: 12px;
                            image-fit: contain;
                        }
                        touch-close-m := TouchArea {
                            clicked => { root.show-receipt-modal = false; root.close-receipt-modal(); }
                            mouse-cursor: pointer;
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border; }

                // Printable Receipt Box Area (1:1 Sesuai Layout Web Kwitansi)
                Rectangle {
                    vertical-stretch: 1;
                    background: #ffffff;
                    border-color: #cbd5e1;
                    border-width: 1px;
                    border-radius: 8px;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;

                        // Kop Sekolah / Komite
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            if root.has-school-logo: Image {
                                source: root.school-logo;
                                width: 44px;
                                height: 44px;
                                image-fit: contain;
                            }
                            if !root.has-school-logo: Rectangle {
                                width: 44px;
                                height: 44px;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                if root.receipt-modal-data.committee_name != "": Text {
                                    text: root.receipt-modal-data.committee_name;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #1e293b;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: root.receipt-modal-data.school_name;
                                    font-size: 14px;
                                    font-weight: 800;
                                    color: #0f172a;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: root.receipt-modal-data.school_address;
                                    font-size: 10px;
                                    color: #64748b;
                                    horizontal-alignment: center;
                                }
                            }
                            Rectangle {
                                width: 44px;
                                height: 44px;
                            }
                        }

                        // Garis Ganda Kop Surat
                        VerticalLayout {
                            spacing: 2px;
                            Rectangle { height: 1px; background: #0f172a; }
                            Rectangle { height: 2px; background: #0f172a; }
                        }

                        // Judul Dokumen Kwitansi
                        Text {
                            text: root.term-kwitansi-upper + " " + root.term-pembayaran-upper;
                            font-size: 12px;
                            font-weight: 800;
                            letter-spacing: 1px;
                            color: #0f172a;
                            horizontal-alignment: center;
                        }

                        // Meta Informasi Transaksi 2 Kolom
                        HorizontalLayout {
                            spacing: 14px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                HorizontalLayout {
                                    Text { width: 85px; text: "No. Transaksi"; font-size: 10px; font-weight: 600; color: #475569; }
                                    Text { text: ": " + root.receipt-modal-data.transaction_code; font-size: 10px; font-weight: 700; color: #0f172a; }
                                }
                                HorizontalLayout {
                                    Text { width: 85px; text: "Nama " + root.term-siswa; font-size: 10px; font-weight: 600; color: #475569; }
                                    Text { text: ": " + root.receipt-modal-data.student_name; font-size: 10px; font-weight: 700; color: #0f172a; }
                                }
                                HorizontalLayout {
                                    Text { width: 85px; text: "Kelas"; font-size: 10px; font-weight: 600; color: #475569; }
                                    Text { text: ": " + root.receipt-modal-data.student_class; font-size: 10px; color: #334155; }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                HorizontalLayout {
                                    Text { width: 60px; text: "Tanggal"; font-size: 10px; font-weight: 600; color: #475569; }
                                    Text { text: ": " + root.receipt-modal-data.created_at; font-size: 10px; color: #334155; }
                                }
                                HorizontalLayout {
                                    Text { width: 60px; text: "NIS"; font-size: 10px; font-weight: 600; color: #475569; }
                                    Text { text: ": " + root.receipt-modal-data.student_nis; font-size: 10px; color: #334155; }
                                }
                                HorizontalLayout {
                                    Text { width: 60px; text: "Metode"; font-size: 10px; font-weight: 600; color: #475569; }
                                    Text { text: ": " + root.receipt-modal-data.payment_method; font-size: 10px; font-weight: 700; color: #059669; }
                                }
                            }
                        }

                        // Tabel Pos Bayar Header
                        Rectangle {
                            height: 24px;
                            background: #f1f5f9;
                            border-color: #cbd5e1;
                            border-width: 1px;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text { width: 28px; text: "No"; font-size: 10px; font-weight: 700; color: #334155; vertical-alignment: center; }
                                Text { horizontal-stretch: 1; text: "Keterangan " + root.term-pembayaran; font-size: 10px; font-weight: 700; color: #334155; vertical-alignment: center; }
                                Text { width: 110px; text: "Jumlah"; font-size: 10px; font-weight: 700; color: #334155; horizontal-alignment: right; vertical-alignment: center; }
                            }
                        }

                        // Daftar Baris Pembayaran
                        Flickable {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                spacing: 2px;
                                for itm in root.receipt-modal-items: VerticalLayout {
                                    spacing: 0px;
                                    Rectangle {
                                        height: 22px;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            Text { width: 28px; text: itm.index; font-size: 10px; color: #64748b; vertical-alignment: center; }
                                            Text { horizontal-stretch: 1; text: itm.description; font-size: 10px; font-weight: 600; color: #0f172a; vertical-alignment: center; }
                                            Text { width: 110px; text: itm.amount; font-size: 10px; font-weight: 700; color: #1e3a8a; horizontal-alignment: right; vertical-alignment: center; }
                                        }
                                    }
                                    Rectangle { height: 1px; background: #f1f5f9; }
                                }
                            }
                        }

                        // Total Pembayaran Row
                        Rectangle {
                            height: 28px;
                            background: #f8fafc;
                            border-color: #cbd5e1;
                            border-width: 1px;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: space-between;
                                Text { text: "Total " + root.term-pembayaran; font-size: 11px; font-weight: 800; color: #0f172a; vertical-alignment: center; }
                                Text { text: root.receipt-modal-data.total_amount; font-size: 12px; font-weight: 800; color: #1e3a8a; vertical-alignment: center; }
                            }
                        }

                        // Catatan (bila ada)
                        if root.receipt-modal-data.notes != "": Text {
                            text: "Catatan: " + root.receipt-modal-data.notes;
                            font-size: 9px;
                            color: #64748b;
                        }

                        // Tanda Tangan & Stempel Petugas (Kanan Bawah)
                        HorizontalLayout {
                            alignment: end;
                            Rectangle {
                                width: 200px;
                                height: 86px;
                                VerticalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: root.receipt-modal-data.receipt_date;
                                        font-size: 10px;
                                        color: #334155;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Petugas Penerima,";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: #0f172a;
                                        horizontal-alignment: center;
                                    }
                                    Rectangle {
                                        height: 30px;
                                        if root.has-receipt-stamp: Image {
                                            x: (parent.width - self.width) / 2 - 20px;
                                            y: -8px;
                                            source: root.receipt-stamp-image;
                                            width: 66px;
                                            height: 66px;
                                            image-fit: contain;
                                            opacity: 0.85;
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Rectangle { height: 1px; background: #334155; }
                                        Text {
                                            text: root.receipt-modal-data.cashier_name;
                                            font-size: 10px;
                                            font-weight: 700;
                                            color: #0f172a;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Footer Bukti Sah
                        Text {
                            text: root.term-kwitansi + " ini merupakan bukti " + root.term-pembayaran-lower + " yang sah • Dicetak oleh Sistem Kasir Partisipasi Sekolah";
                            font-size: 8px;
                            color: #94a3b8;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Modal Actions
                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    Rectangle {
                        width: 90px;
                        height: 36px;
                        background: touch-close-btn.has-hover ? #e2e8f0 : #f1f5f9;
                        border-radius: 6px;
                        animate background { duration: 150ms; }
                        touch-close-btn := TouchArea {
                            clicked => { root.show-receipt-modal = false; root.close-receipt-modal(); }
                            mouse-cursor: pointer;
                        }
                        Text {
                            text: "Tutup";
                            font-size: 12px;
                            font-weight: 700;
                            color: Theme.text-main;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 160px;
                        height: 36px;
                        background: touch-prn-btn.has-hover ? Theme.primary-hover : Theme.primary;
                        border-radius: 6px;
                        animate background { duration: 150ms; }
                        touch-prn-btn := TouchArea {
                            clicked => { root.execute-direct-print(root.receipt-modal-data.transaction_code); }
                            mouse-cursor: pointer;
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                width: 13px;
                                Image {
                                    source: @image-url("assets/icons/print.svg");
                                    width: 13px;
                                    height: 13px;
                                    image-fit: contain;
                                    colorize: white;
                                }
                            }
                            Text {
                                text: "Cetak " + root.term-kwitansi;
                                font-size: 12px;
                                font-weight: 700;
                                color: white;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal Tentang & Pembaruan Sistem (About & Update Modal)
    if root.show-about-modal: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #00000055;
        z: 110;

        // Backdrop Dismiss Touch
        TouchArea {
            clicked => { root.show-about-modal = false; }
        }

        // Dialog Card
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 480px;
            height: 440px;
            background: #ffffff;
            border-radius: 12px;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000040;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                // Header Tentang
                HorizontalLayout {
                    alignment: space-between;
                    height: 28px;

                    Text {
                        text: "Tentang Aplikasi";
                        font-size: 16px;
                        font-weight: 800;
                        color: Theme.text-main;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: touch-close-about.has-hover ? #f1f5f9 : transparent;
                        animate background { duration: 150ms; }
                        touch-close-about := TouchArea {
                            clicked => { root.show-about-modal = false; }
                            mouse-cursor: pointer;
                        }
                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("assets/icons/close.svg");
                                    width: 12px;
                                    height: 12px;
                                    image-fit: contain;
                                    colorize: Theme.text-muted;
                                }
                            }
                        }
                    }
                }

                // Brand Banner
                Rectangle {
                    background: #f8fafc;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 8px;

                    HorizontalLayout {
                        padding: 14px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            width: 48px;
                            Rectangle {
                                width: 48px;
                                height: 48px;
                                border-radius: 10px;
                                background: Theme.primary-light;
                                if root.has-school-logo: Image {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    source: root.school-logo;
                                    width: 36px;
                                    height: 36px;
                                    image-fit: contain;
                                }
                                if !root.has-school-logo: Image {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    source: @image-url("assets/icons/bill.svg");
                                    width: 26px;
                                    height: 26px;
                                    image-fit: contain;
                                    colorize: Theme.primary;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            Text {
                                text: "Partisipasi Sekolah Desktop";
                                font-size: 15px;
                                font-weight: 800;
                                color: Theme.primary;
                            }
                            Text {
                                text: "Aplikasi Kasir dan Pembayaran Sumbangan Sekolah";
                                font-size: 11px;
                                color: Theme.text-muted;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle {
                                    height: 18px;
                                    background: #dbeafe;
                                    border-radius: 9px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "Versi 0.2.0";
                                            font-size: 10px;
                                            font-weight: 700;
                                            color: Theme.primary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Info Details Grid
                Rectangle {
                    background: #ffffff;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 8px;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Pengembang:"; font-size: 11px; color: Theme.text-muted; }
                            Text { text: "PMTI SMAN 1 GEDEG"; font-size: 11px; font-weight: 600; color: Theme.text-main; }
                        }
                        Rectangle { height: 1px; background: Theme.border-muted; }
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Instansi:"; font-size: 11px; color: Theme.text-muted; }
                            Text { text: "SMA Negeri 1 Gedeg"; font-size: 11px; font-weight: 600; color: Theme.text-main; }
                        }
                        Rectangle { height: 1px; background: Theme.border-muted; }
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Layanan:"; font-size: 11px; color: Theme.text-muted; }
                            Text { text: "Pembayaran Sumbangan & Kasir POS"; font-size: 11px; font-weight: 600; color: Theme.emerald; }
                        }
                        Rectangle { height: 1px; background: Theme.border-muted; }
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Status:"; font-size: 11px; color: Theme.text-muted; }
                            Text { text: "Siap Digunakan (v0.2.0)"; font-size: 11px; font-weight: 600; color: Theme.primary; }
                        }
                    }
                }

                // Status Pembaruan Otomatis Card
                Rectangle {
                    background: #f0fdf4;
                    border-color: #bbf7d0;
                    border-width: 1px;
                    border-radius: 8px;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;
                        Text {
                            text: "Status Pembaruan Otomatis:";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.emerald;
                        }
                        Text {
                            text: root.update-status-text != "" ? root.update-status-text : "Aplikasi menggunakan versi terbaru (v0.2.0).";
                            font-size: 11px;
                            color: Theme.text-main;
                        }
                    }
                }

                // Action Buttons
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    Rectangle {
                        width: 160px;
                        height: 36px;
                        background: touch-check-update.has-hover ? #e2e8f0 : #f1f5f9;
                        border-radius: 6px;
                        animate background { duration: 150ms; }
                        touch-check-update := TouchArea {
                            clicked => { root.check-for-updates(); }
                            mouse-cursor: pointer;
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                width: 13px;
                                Image {
                                    source: @image-url("assets/icons/sync.svg");
                                    width: 13px;
                                    height: 13px;
                                    image-fit: contain;
                                    colorize: Theme.primary;
                                }
                            }
                            Text {
                                text: "Periksa Pembaruan";
                                font-size: 12px;
                                font-weight: 700;
                                color: Theme.primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        width: 90px;
                        height: 36px;
                        background: touch-about-close-btn.has-hover ? Theme.primary-hover : Theme.primary;
                        border-radius: 6px;
                        animate background { duration: 150ms; }
                        touch-about-close-btn := TouchArea {
                            clicked => { root.show-about-modal = false; }
                            mouse-cursor: pointer;
                        }
                        Text {
                            text: "Tutup";
                            font-size: 12px;
                            font-weight: 700;
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
