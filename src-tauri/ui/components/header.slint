import { Theme } from "../theme.slint";

export component Header inherits Rectangle {
    height: Theme.header-height;
    background: Theme.bg-card;
    border-color: Theme.border;
    border-width: 1px;

    in-out property <string> search-query: "";
    in property <string> active-academic-year: "2024/2025";
    in property <bool> is-syncing: false;

    callback search-changed(string);
    callback search-submitted(string);
    callback trigger-sync-clicked();
    callback about-clicked();

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 16px;
        alignment: space-between;

        // Rounded Search Bar Pill (480px, Vertically Centered)
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 480px;
                height: 38px;
                background: #f8fafc;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 19px;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;

                    VerticalLayout {
                        alignment: center;
                        width: 16px;
                        Image {
                            source: @image-url("../assets/icons/search.svg");
                            width: 15px;
                            height: 15px;
                            image-fit: contain;
                            colorize: Theme.text-muted;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;

                        if root.search-query == "": Text {
                            x: 0px;
                            width: 100%;
                            height: 100%;
                            text: "Cari Siswa berdasarkan Nama atau NIS/NISN...";
                            color: #94a3b8;
                            font-size: 13px;
                            vertical-alignment: center;
                        }

                        TextInput {
                            width: 100%;
                            height: 100%;
                            text <=> root.search-query;
                            font-size: 13px;
                            color: Theme.text-main;
                            vertical-alignment: center;
                            edited => {
                                root.search-changed(self.text);
                            }
                            accepted => {
                                root.search-submitted(self.text);
                            }
                        }
                    }
                }
            }
        }

        // Kanan: Tahun Ajaran & Tombol Sinkron (Vertically Centered)
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 12px;

                // Rounded Badge Pill T.A
                Rectangle {
                    height: 34px;
                    background: Theme.bg-secondary;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 17px;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 6px;
                        alignment: center;
                        Text {
                            text: "T.A:";
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.active-academic-year;
                            font-size: 12px;
                            font-weight: 700;
                            color: Theme.primary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Rounded Button Pill Sinkronkan
                Rectangle {
                    width: 130px;
                    height: 34px;
                    background: root.is-syncing ? #94a3b8 : touch-sync.has-hover ? Theme.primary-hover : Theme.primary;
                    border-radius: 17px;
                    animate background { duration: 150ms; }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;
                            width: 14px;
                            Image {
                                source: @image-url("../assets/icons/sync.svg");
                                width: 13px;
                                height: 13px;
                                image-fit: contain;
                                colorize: white;
                            }
                        }

                        Text {
                            text: root.is-syncing ? "Sinkron..." : "Sinkronkan";
                            color: white;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    touch-sync := TouchArea {
                        enabled: !root.is-syncing;
                        clicked => { root.trigger-sync-clicked(); }
                        mouse-cursor: pointer;
                    }
                }

                // Rounded Button Pill Tentang / Bantuan / Info Versi
                Rectangle {
                    width: 34px;
                    height: 34px;
                    background: touch-about.has-hover ? #e2e8f0 : Theme.bg-secondary;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 17px;
                    animate background { duration: 150ms; }

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "ℹ";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.primary;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    touch-about := TouchArea {
                        clicked => { root.about-clicked(); }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }
}
