import { Theme } from "../theme.slint";

export component Header inherits Rectangle {
    height: Theme.header-height;
    background: Theme.bg-card;
    border-color: Theme.border;
    border-width: 1px;

    in-out property <string> search-query: "";
    in property <string> active-academic-year: "2024/2025";
    in property <bool> is-syncing: false;

    callback search-changed(string);
    callback search-submitted(string);
    callback trigger-sync-clicked();

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 16px;
        alignment: space-between;

        // Search Student Bar (480px wide)
        Rectangle {
            width: 480px;
            height: 42px;
            background: Theme.bg-primary;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 8px;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                alignment: center;

                Text {
                    text: "🔍";
                    font-size: 14px;
                    vertical-alignment: center;
                }

                input := TextInput {
                    text <=> root.search-query;
                    font-size: 13px;
                    color: Theme.text-main;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    edited => {
                        root.search-changed(self.text);
                    }
                    accepted => {
                        root.search-submitted(self.text);
                    }
                }

                if root.search-query == "": Text {
                    text: "Ketik Nama atau NIS/NISN Siswa...";
                    font-size: 13px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }
        }

        // Right side indicators & action
        HorizontalLayout {
            spacing: 12px;
            alignment: end;

            // Academic Year Badge
            Rectangle {
                height: 36px;
                background: Theme.bg-secondary;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 6px;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 6px;
                    alignment: center;
                    Text {
                        text: "📅 TA:";
                        font-size: 12px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.active-academic-year;
                        font-size: 12px;
                        font-weight: 700;
                        color: Theme.primary;
                        vertical-alignment: center;
                    }
                }
            }

            // Quick Sync Button
            Rectangle {
                width: 140px;
                height: 36px;
                background: root.is-syncing ? #e0e0e0 : Theme.primary;
                border-radius: 6px;

                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    Text {
                        text: root.is-syncing ? "⏳" : "🔄";
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.is-syncing ? "Sinkronisasi..." : "Sinkronkan";
                        color: root.is-syncing ? Theme.text-muted : white;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                touch-sync := TouchArea {
                    enabled: !root.is-syncing;
                    clicked => { root.trigger-sync-clicked(); }
                    mouse-cursor: pointer;
                }
            }
        }
    }
}
