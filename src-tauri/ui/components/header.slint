import { Theme } from "../theme.slint";

export component Header inherits Rectangle {
    height: Theme.header-height;
    background: Theme.bg-card;
    border-color: Theme.border;
    border-width: 1px;

    in-out property <string> search-query: "";
    in property <string> active-academic-year: "2024/2025";
    in property <bool> is-syncing: false;

    callback search-changed(string);
    callback search-submitted(string);
    callback trigger-sync-clicked();

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 16px;
        alignment: space-between;

        // Search Bar (Input Siswa)
        Rectangle {
            horizontal-stretch: 1;
            max-width: 520px;
            height: 40px;
            background: Theme.bg-primary;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 8px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: center;

                Image {
                    source: @image-url("../assets/icons/search.svg");
                    width: 16px;
                    height: 16px;
                    image-fit: contain;
                    colorize: Theme.text-muted;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 38px;

                    if root.search-query == "": Text {
                        x: 0px;
                        text: "Cari Siswa berdasarkan Nama atau NIS/NISN...";
                        color: Theme.text-muted;
                        font-size: 13px;
                        vertical-alignment: center;
                    }

                    TextInput {
                        width: 100%;
                        height: 100%;
                        text <=> root.search-query;
                        font-size: 13px;
                        color: Theme.text-main;
                        vertical-alignment: center;
                        edited => {
                            root.search-changed(self.text);
                        }
                        accepted => {
                            root.search-submitted(self.text);
                        }
                    }
                }
            }
        }

        // Action & Status di sebelah kanan
        HorizontalLayout {
            spacing: 10px;
            alignment: end;

            // Badge Tahun Ajaran
            Rectangle {
                height: 38px;
                background: Theme.bg-secondary;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 6px;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 6px;
                    alignment: center;
                    Text {
                        text: "T.A:";
                        font-size: 12px;
                        font-weight: 500;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.active-academic-year;
                        font-size: 12px;
                        font-weight: 700;
                        color: Theme.primary;
                        vertical-alignment: center;
                    }
                }
            }

            // Tombol Sinkronisasi
            Rectangle {
                min-width: 130px;
                height: 38px;
                background: root.is-syncing ? #94a3b8 : Theme.primary;
                border-radius: 6px;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    alignment: center;
                    spacing: 8px;

                    Image {
                        source: @image-url("../assets/icons/sync.svg");
                        width: 14px;
                        height: 14px;
                        image-fit: contain;
                    }

                    Text {
                        text: root.is-syncing ? "Sinkron..." : "Sinkronkan";
                        color: white;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                touch-sync := TouchArea {
                    enabled: !root.is-syncing;
                    clicked => { root.trigger-sync-clicked(); }
                    mouse-cursor: pointer;
                }
            }
        }
    }
}
