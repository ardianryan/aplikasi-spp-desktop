import { Theme } from "../theme.slint";

export component SidebarItem inherits Rectangle {
    in property <string> title: "";
    in property <bool> is-active: false;
    in property <string> badge-text: "";
    callback clicked();

    height: 48px;
    background: is-active ? Theme.primary-light : touch.has-hover ? #e4ebfa : transparent;
    border-radius: 8px;
    animate background { duration: 150ms; }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        alignment: center;

        // Left accent indicator for active item
        if is-active: Rectangle {
            width: 4px;
            height: 24px;
            background: Theme.primary;
            border-radius: 2px;
        }

        Text {
            text: root.title;
            color: is-active ? Theme.on-primary-light : Theme.text-main;
            font-size: 14px;
            font-weight: is-active ? 700 : 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        if root.badge-text != "": Rectangle {
            background: Theme.rose;
            border-radius: 10px;
            height: 20px;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Text {
                    text: root.badge-text;
                    color: white;
                    font-size: 11px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

export component Sidebar inherits Rectangle {
    width: Theme.sidebar-width;
    background: Theme.bg-secondary;
    border-color: Theme.border;
    border-width: 1px;

    in property <int> active-tab: 0; // 0: POS, 1: Savings, 2: History, 3: Reports, 4: Sync
    in property <string> user-name: "Kasir Loket 1";
    in property <string> user-role: "Petugas Kasir";
    in property <bool> is-online: false;
    in property <string> pending-sync-count: "0";

    callback tab-selected(int);
    callback logout-clicked();

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        // Header App Brand
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Rectangle {
                    width: 36px;
                    height: 36px;
                    background: Theme.primary;
                    border-radius: 8px;
                    Text {
                        text: "P";
                        color: white;
                        font-size: 20px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Partisipasi";
                        font-size: 17px;
                        font-weight: 700;
                        color: Theme.primary;
                    }
                    Text {
                        text: "Sistem Kasir SPP v0.2.0";
                        font-size: 11px;
                        color: Theme.text-muted;
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        // Navigation Items
        VerticalLayout {
            spacing: 6px;
            horizontal-stretch: 1;

            SidebarItem {
                title: "POS Kasir";
                is-active: root.active-tab == 0;
                clicked => { root.tab-selected(0); }
            }

            SidebarItem {
                title: "Tabungan Siswa";
                is-active: root.active-tab == 1;
                clicked => { root.tab-selected(1); }
            }

            SidebarItem {
                title: "Riwayat Transaksi";
                is-active: root.active-tab == 2;
                clicked => { root.tab-selected(2); }
            }

            SidebarItem {
                title: "Laporan Kas";
                is-active: root.active-tab == 3;
                clicked => { root.tab-selected(3); }
            }

            SidebarItem {
                title: "Pengaturan Sync";
                is-active: root.active-tab == 4;
                badge-text: root.pending-sync-count == "0" ? "" : root.pending-sync-count;
                clicked => { root.tab-selected(4); }
            }
        }

        // Spacer to push footer to bottom
        Rectangle {
            vertical-stretch: 1;
        }

        // Footer User Info & Status
        Rectangle {
            background: Theme.bg-card;
            border-radius: 10px;
            border-color: Theme.border;
            border-width: 1px;
            height: 120px;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        background: Theme.primary-light;
                        border-radius: 16px;
                        Text {
                            text: "K";
                            color: Theme.on-primary-light;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.user-name;
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text-main;
                            overflow: elide;
                        }
                        Text {
                            text: root.user-role;
                            font-size: 11px;
                            color: Theme.text-muted;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.is-online ? Theme.emerald : Theme.amber;
                        y: 4px;
                    }
                    Text {
                        text: root.is-online ? "Sinkronisasi Online" : "Mode Offline Mandiri";
                        font-size: 11px;
                        font-weight: 600;
                        color: root.is-online ? Theme.emerald : Theme.amber;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 28px;
                    background: #fbeae8;
                    border-radius: 6px;
                    touch-logout := TouchArea {
                        clicked => { root.logout-clicked(); }
                        mouse-cursor: pointer;
                    }
                    Text {
                        text: "Keluar Sesi";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.rose;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
