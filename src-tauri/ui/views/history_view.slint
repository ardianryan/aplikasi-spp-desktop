import { Theme } from "../theme.slint";

export struct HistoryRecord {
    id: string,
    transaction_code: string,
    student_name: string,
    student_class: string,
    payment_method: string,
    total_amount: string,
    notes: string,
    created_at: string,
    sync_status: string,
}

export component HistoryView inherits Rectangle {
    background: Theme.bg-primary;

    in property <[HistoryRecord]> records: [];
    in-out property <string> filter-search: "";
    callback refresh-clicked();
    callback print-receipt(string);

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "Riwayat Transaksi Keseluruhan";
                font-size: 20px;
                font-weight: 700;
                color: Theme.text-main;
                vertical-alignment: center;
            }

            Rectangle {
                width: 120px;
                height: 36px;
                background: Theme.primary;
                border-radius: 6px;
                TouchArea {
                    clicked => { root.refresh-clicked(); }
                    mouse-cursor: pointer;
                }
                Text {
                    text: "🔄 Segarkan";
                    color: white;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Search Filter
        Rectangle {
            height: 44px;
            background: Theme.bg-card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 8px;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;
                alignment: center;
                Text {
                    text: "🔍";
                    font-size: 13px;
                    vertical-alignment: center;
                }
                TextInput {
                    text <=> root.filter-search;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if root.filter-search == "": Text {
                    text: "Saring transaksi berdasarkan nomor struk atau nama...";
                    color: Theme.text-muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }

        // Table Container
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 10px;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                // Columns Header
                Rectangle {
                    height: 36px;
                    background: Theme.bg-secondary;
                    border-radius: 6px;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        alignment: center;
                        Text { width: 140px; text: "No. Transaksi"; font-size: 12px; font-weight: 600; color: Theme.text-muted; }
                        Text { horizontal-stretch: 1; text: "Nama Siswa / Kelas"; font-size: 12px; font-weight: 600; color: Theme.text-muted; }
                        Text { width: 100px; text: "Metode"; font-size: 12px; font-weight: 600; color: Theme.text-muted; }
                        Text { width: 110px; text: "Total"; font-size: 12px; font-weight: 600; color: Theme.text-muted; horizontal-alignment: right; }
                        Text { width: 130px; text: "Tanggal & Jam"; font-size: 12px; font-weight: 600; color: Theme.text-muted; horizontal-alignment: right; }
                        Text { width: 80px; text: "Sync"; font-size: 12px; font-weight: 600; color: Theme.text-muted; horizontal-alignment: center; }
                        Text { width: 50px; text: "Struk"; font-size: 12px; font-weight: 600; color: Theme.text-muted; horizontal-alignment: center; }
                    }
                }

                // Records Scroll
                Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        for row in root.records: Rectangle {
                            height: 42px;
                            background: Theme.bg-secondary;
                            border-radius: 6px;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 8px;
                                alignment: center;

                                Text {
                                    width: 140px;
                                    text: row.transaction_code;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: Theme.primary;
                                    vertical-alignment: center;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: row.student_name + " (" + row.student_class + ")";
                                    font-size: 12px;
                                    color: Theme.text-main;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: 100px;
                                    text: row.payment_method;
                                    font-size: 12px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: 110px;
                                    text: row.total_amount;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: Theme.emerald;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: 130px;
                                    text: row.created_at;
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                // Sync Status Badge
                                Rectangle {
                                    width: 80px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: row.sync_status == "synced" ? Theme.emerald-light : Theme.amber-light;
                                    Text {
                                        text: row.sync_status == "synced" ? "TERKIRIM" : "ANTRIAN";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: row.sync_status == "synced" ? Theme.emerald : Theme.amber;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Print Button
                                Rectangle {
                                    width: 50px;
                                    height: 26px;
                                    background: Theme.primary-light;
                                    border-radius: 4px;
                                    TouchArea {
                                        clicked => { root.print-receipt(row.transaction_code); }
                                        mouse-cursor: pointer;
                                    }
                                    Text {
                                        text: "🖨️ Cetak";
                                        font-size: 10px;
                                        font-weight: 600;
                                        color: Theme.on-primary-light;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
