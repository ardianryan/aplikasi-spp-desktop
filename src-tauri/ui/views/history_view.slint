import { Theme } from "../theme.slint";

export struct HistoryRecord {
    id: string,
    transaction_code: string,
    student_name: string,
    student_class: string,
    payment_method: string,
    total_amount: string,
    notes: string,
    created_at: string,
    sync_status: string,
}

export component HistoryView inherits Rectangle {
    background: Theme.bg-primary;

    in property <[HistoryRecord]> records: [];
    in-out property <string> filter-search: "";
    in property <string> term-pembayaran: "Pembayaran";
    in property <string> term-siswa: "Siswa";
    in property <string> term-siswa-lower: "siswa";
    callback refresh-clicked();
    callback print-receipt(string);
    callback search-changed(string);

    VerticalLayout {
        padding: 16px;
        spacing: 14px;

        HorizontalLayout {
            height: 36px;
            alignment: space-between;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    width: 20px;
                    Image {
                        source: @image-url("../assets/icons/history.svg");
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                        colorize: Theme.primary;
                    }
                }
                Text {
                    text: "Riwayat Transaksi Keseluruhan";
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text-main;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: 120px;
                height: 36px;
                background: Theme.primary;
                border-radius: 6px;
                TouchArea {
                    clicked => { root.refresh-clicked(); }
                    mouse-cursor: pointer;
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        width: 14px;
                        Image {
                            source: @image-url("../assets/icons/sync.svg");
                            width: 12px;
                            height: 12px;
                            image-fit: contain;
                            colorize: white;
                        }
                    }
                    Text {
                        text: "Segarkan";
                        color: white;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Search Filter
        Rectangle {
            height: 40px;
            background: Theme.bg-card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 8px;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    width: 16px;
                    Image {
                        source: @image-url("../assets/icons/search.svg");
                        width: 16px;
                        height: 16px;
                        image-fit: contain;
                        colorize: Theme.text-muted;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 38px;

                    if root.filter-search == "": Text {
                        x: 0px;
                        text: "Saring transaksi berdasarkan nomor struk atau nama " + root.term-siswa-lower + "...";
                        color: Theme.text-muted;
                        font-size: 13px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }

                    TextInput {
                        width: 100%;
                        height: 100%;
                        text <=> root.filter-search;
                        font-size: 13px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        edited => { root.search-changed(self.text); }
                    }
                }
            }
        }

        // Table Container
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 8px;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                // Columns Header
                Rectangle {
                    height: 36px;
                    background: Theme.bg-secondary;
                    border-radius: 6px;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        Text { width: 160px; text: "No. Transaksi"; font-size: 11px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Nama " + root.term-siswa + " / Kelas"; font-size: 11px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                        Text { width: 90px; text: "Metode"; font-size: 11px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                        Text { width: 110px; text: "Total"; font-size: 11px; font-weight: 700; color: Theme.text-muted; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 140px; text: "Tanggal & Jam"; font-size: 11px; font-weight: 700; color: Theme.text-muted; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 85px; text: "Status Sync"; font-size: 11px; font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 75px; text: "Aksi"; font-size: 11px; font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                if root.records.length == 0: Rectangle {
                    vertical-stretch: 1;
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "Belum ada catatan riwayat transaksi.";
                            font-size: 12px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.records.length > 0: Flickable {
                    vertical-stretch: 1;
                    content-height: root.records.length * 46px;
                    VerticalLayout {
                        alignment: start;
                        spacing: 4px;
                        for row in root.records: Rectangle {
                            height: 42px;
                            background: Theme.bg-secondary;
                            border-radius: 4px;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 8px;

                                Text {
                                    width: 160px;
                                    text: row.transaction_code;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Theme.primary;
                                    vertical-alignment: center;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: row.student_name + " (" + row.student_class + ")";
                                    font-size: 11px;
                                    color: Theme.text-main;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: 90px;
                                    text: row.payment_method;
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: 110px;
                                    text: row.total_amount;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Theme.emerald;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: 140px;
                                    text: row.created_at;
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                // Sync Status Badge
                                Rectangle {
                                    width: 85px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: row.sync_status == "synced" ? Theme.emerald-light : Theme.amber-light;
                                    Text {
                                        text: row.sync_status == "synced" ? "TERKIRIM" : "ANTREAN";
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: row.sync_status == "synced" ? Theme.emerald : Theme.amber;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Tombol Cetak Struk
                                VerticalLayout {
                                    alignment: center;
                                    width: 75px;
                                    Rectangle {
                                        width: 70px;
                                        height: 28px;
                                        background: touch-print.has-hover ? #dbeafe : Theme.primary-light;
                                        border-color: touch-print.has-hover ? #bfdbfe : transparent;
                                        border-width: 1px;
                                        border-radius: 6px;
                                        animate background { duration: 150ms; }
                                        touch-print := TouchArea {
                                            clicked => { root.print-receipt(row.transaction_code); }
                                            mouse-cursor: pointer;
                                        }
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 5px;
                                            VerticalLayout {
                                                alignment: center;
                                                width: 12px;
                                                Image {
                                                    source: @image-url("../assets/icons/print.svg");
                                                    width: 12px;
                                                    height: 12px;
                                                    image-fit: contain;
                                                    colorize: Theme.primary;
                                                }
                                            }
                                            Text {
                                                text: "Cetak";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: Theme.on-primary-light;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
