import { Theme } from "../theme.slint";

export struct HistoryRecord {
    id: string,
    transaction_code: string,
    student_name: string,
    student_class: string,
    payment_method: string,
    total_amount: string,
    notes: string,
    created_at: string,
    sync_status: string,
}

export component HistoryView inherits Rectangle {
    background: Theme.bg-primary;

    in property <[HistoryRecord]> records: [];
    in-out property <string> filter-search: "";
    callback refresh-clicked();
    callback print-receipt(string);

    VerticalLayout {
        padding: 16px;
        spacing: 14px;

        HorizontalLayout {
            height: 36px;
            alignment: space-between;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Image {
                    source: @image-url("../assets/icons/history.svg");
                    width: 18px;
                    height: 18px;
                    image-fit: contain;
                    colorize: Theme.primary;
                    y: 9px;
                }
                Text {
                    text: "Riwayat Transaksi Keseluruhan";
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text-main;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: 120px;
                height: 36px;
                background: Theme.primary;
                border-radius: 6px;
                TouchArea {
                    clicked => { root.refresh-clicked(); }
                    mouse-cursor: pointer;
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    Image {
                        source: @image-url("../assets/icons/sync.svg");
                        width: 12px;
                        height: 12px;
                        image-fit: contain;
                    }
                    Text {
                        text: "Segarkan";
                        color: white;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Search Filter
        Rectangle {
            height: 40px;
            background: Theme.bg-card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 8px;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                alignment: center;

                Image {
                    source: @image-url("../assets/icons/search.svg");
                    width: 16px;
                    height: 16px;
                    image-fit: contain;
                    colorize: Theme.text-muted;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 38px;

                    if root.filter-search == "": Text {
                        x: 0px;
                        text: "Saring transaksi berdasarkan nomor struk atau nama siswa...";
                        color: Theme.text-muted;
                        font-size: 13px;
                        vertical-alignment: center;
                    }

                    TextInput {
                        width: 100%;
                        height: 100%;
                        text <=> root.filter-search;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Table Container
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 8px;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                // Columns Header
                Rectangle {
                    height: 36px;
                    background: Theme.bg-secondary;
                    border-radius: 6px;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        alignment: center;
                        Text { width: 150px; text: "No. Transaksi"; font-size: 11px; font-weight: 700; color: Theme.text-muted; }
                        Text { horizontal-stretch: 1; text: "Nama Siswa / Kelas"; font-size: 11px; font-weight: 700; color: Theme.text-muted; }
                        Text { width: 100px; text: "Metode"; font-size: 11px; font-weight: 700; color: Theme.text-muted; }
                        Text { width: 110px; text: "Total"; font-size: 11px; font-weight: 700; color: Theme.text-muted; horizontal-alignment: right; }
                        Text { width: 130px; text: "Tanggal & Jam"; font-size: 11px; font-weight: 700; color: Theme.text-muted; horizontal-alignment: right; }
                        Text { width: 80px; text: "Status Sync"; font-size: 11px; font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; }
                        Text { width: 50px; text: "Aksi"; font-size: 11px; font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; }
                    }
                }

                if root.records.length == 0: Rectangle {
                    vertical-stretch: 1;
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "Belum ada catatan riwayat transaksi.";
                            font-size: 12px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.records.length > 0: Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        for row in root.records: Rectangle {
                            height: 38px;
                            background: Theme.bg-secondary;
                            border-radius: 4px;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 8px;
                                alignment: center;

                                Text {
                                    width: 150px;
                                    text: row.transaction_code;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Theme.primary;
                                    vertical-alignment: center;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: row.student_name + " (" + row.student_class + ")";
                                    font-size: 11px;
                                    color: Theme.text-main;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: 100px;
                                    text: row.payment_method;
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: 110px;
                                    text: row.total_amount;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Theme.emerald;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: 130px;
                                    text: row.created_at;
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                // Sync Status Badge
                                Rectangle {
                                    width: 80px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: row.sync_status == "synced" ? Theme.emerald-light : Theme.amber-light;
                                    Text {
                                        text: row.sync_status == "synced" ? "TERKIRIM" : "ANTREAN";
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: row.sync_status == "synced" ? Theme.emerald : Theme.amber;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Tombol Cetak Struk
                                Rectangle {
                                    width: 50px;
                                    height: 24px;
                                    background: Theme.primary-light;
                                    border-radius: 4px;
                                    TouchArea {
                                        clicked => { root.print-receipt(row.transaction_code); }
                                        mouse-cursor: pointer;
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Image {
                                            source: @image-url("../assets/icons/print.svg");
                                            width: 11px;
                                            height: 11px;
                                            image-fit: contain;
                                            colorize: Theme.primary;
                                        }
                                        Text {
                                            text: "Cetak";
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: Theme.on-primary-light;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
