import { Theme } from "../theme.slint";

export struct StudentData {
    id: string,
    nis: string,
    nisn: string,
    nama: string,
    kelas: string,
    savings_balance: string,
}

export struct BillSummaryData {
    total_tagihan: string,
    total_dibayar: string,
    total_keringanan: string,
    total_tunggakan: string,
}

export struct AssignmentData {
    id: string,
    payment_type_name: string,
    payment_type_type: string,
    month_name: string,
    amount: string,
    paid_amount: string,
    remaining_amount: string,
    remaining_raw: int,
    status: string, // "lunas", "sebagian", "belum_bayar"
    is_selected: bool,
}

export struct CartItemData {
    assignment_id: string,
    name: string,
    remaining_text: string,
    pay_amount_text: string,
}

export struct TodayPaymentData {
    transaction_code: string,
    student_name: string,
    total_amount: string,
    payment_method: string,
    created_at: string,
}

// 4 Kartu Ringkasan (Summary Card Component)
component SummaryCard inherits Rectangle {
    in property <string> title: "";
    in property <string> amount: "Rp 0";
    in property <color> card-color: Theme.primary;
    in property <color> card-light-color: Theme.primary-light;

    background: Theme.bg-card;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 10px;
    height: 84px;

    HorizontalLayout {
        padding: 16px;
        spacing: 14px;
        alignment: start;

        Rectangle {
            width: 44px;
            height: 44px;
            background: root.card-light-color;
            border-radius: 10px;
            Text {
                text: "💳";
                font-size: 18px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-size: 12px;
                color: Theme.text-muted;
                font-weight: 500;
            }
            Text {
                text: root.amount;
                font-size: 17px;
                color: root.card-color;
                font-weight: 700;
            }
        }
    }
}

export component PosView inherits Rectangle {
    background: Theme.bg-primary;

    in property <StudentData> current-student: {
        id: "",
        nis: "-",
        nisn: "-",
        nama: "Pilih / Cari Siswa Di Atas",
        kelas: "-",
        savings_balance: "Rp 0"
    };

    in property <BillSummaryData> summary: {
        total_tagihan: "Rp 0",
        total_dibayar: "Rp 0",
        total_keringanan: "Rp 0",
        total_tunggakan: "Rp 0"
    };

    in property <[AssignmentData]> assignments: [];
    in property <[CartItemData]> cart-items: [];
    in property <[TodayPaymentData]> today-payments: [];
    in property <string> cart-total: "Rp 0";
    in property <int> selected-payment-method: 0; // 0: Tunai, 1: Transfer, 2: Tabungan
    in property <bool> is-processing-payment: false;

    callback toggle-assignment-selection(string);
    callback remove-cart-item(string);
    callback select-payment-method(int);
    callback process-payment-clicked();
    callback print-receipt-clicked(string);

    VerticalLayout {
        padding: 20px;
        spacing: 18px;

        // 1. Info Bar Siswa Terpilih
        Rectangle {
            height: 64px;
            background: Theme.bg-card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 10px;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 24px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        background: Theme.primary-light;
                        border-radius: 20px;
                        y: 12px;
                        Text {
                            text: "🎓";
                            font-size: 18px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.current-student.nama;
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.text-main;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "NIS: " + root.current-student.nis;
                                font-size: 12px;
                                color: Theme.text-muted;
                            }
                            Text {
                                text: "Kelas: " + root.current-student.kelas;
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.primary;
                            }
                        }
                    }
                }

                // Saldo Tabungan Badge
                Rectangle {
                    height: 38px;
                    background: Theme.emerald-light;
                    border-radius: 8px;
                    y: 13px;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        alignment: center;
                        Text {
                            text: "💰 Tabungan:";
                            font-size: 12px;
                            color: Theme.emerald-hover;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.current-student.savings_balance;
                            font-size: 13px;
                            font-weight: 800;
                            color: Theme.emerald;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // 2. 4 Summary Cards Grid
        HorizontalLayout {
            spacing: 14px;
            SummaryCard {
                title: "Total Tagihan";
                amount: root.summary.total_tagihan;
                card-color: Theme.primary;
                card-light-color: Theme.primary-light;
                horizontal-stretch: 1;
            }
            SummaryCard {
                title: "Sudah Dibayar";
                amount: root.summary.total_dibayar;
                card-color: Theme.emerald;
                card-light-color: Theme.emerald-light;
                horizontal-stretch: 1;
            }
            SummaryCard {
                title: "Keringanan (Relief)";
                amount: root.summary.total_keringanan;
                card-color: Theme.amber;
                card-light-color: Theme.amber-light;
                horizontal-stretch: 1;
            }
            SummaryCard {
                title: "Tunggakan / Sisa";
                amount: root.summary.total_tunggakan;
                card-color: Theme.rose;
                card-light-color: Theme.rose-light;
                horizontal-stretch: 1;
            }
        }

        // 3. Main Center Split (Tabel Tagihan di Kiri & Panel Cart di Kanan)
        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 1;

            // Kiri: Tabel Tagihan Siswa
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.bg-card;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 10px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    // Table Header Bar
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Daftar Tagihan & Pos Biaya";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text-main;
                        }
                        Text {
                            text: "Klik item untuk masukkan ke keranjang bayar";
                            font-size: 12px;
                            color: Theme.text-muted;
                        }
                    }

                    // Table Columns Header
                    Rectangle {
                        height: 36px;
                        background: Theme.bg-secondary;
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;
                            alignment: center;
                            Text { width: 36px; text: "Pilih"; font-size: 12px; font-weight: 600; color: Theme.text-muted; }
                            Text { horizontal-stretch: 1; text: "Nama Pos / Periode"; font-size: 12px; font-weight: 600; color: Theme.text-muted; }
                            Text { width: 100px; text: "Total"; font-size: 12px; font-weight: 600; color: Theme.text-muted; horizontal-alignment: right; }
                            Text { width: 100px; text: "Sisa"; font-size: 12px; font-weight: 600; color: Theme.text-muted; horizontal-alignment: right; }
                            Text { width: 90px; text: "Status"; font-size: 12px; font-weight: 600; color: Theme.text-muted; horizontal-alignment: center; }
                        }
                    }

                    // Table Scrollable Items
                    Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            for item in root.assignments: Rectangle {
                                height: 44px;
                                background: item.is_selected ? #e8f0fe : touch-item.has-hover ? #f6f8fd : transparent;
                                border-color: item.is_selected ? Theme.primary : Theme.border-muted;
                                border-width: 1px;
                                border-radius: 6px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 8px;
                                    alignment: center;

                                    // Selection checkbox box
                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        background: item.is_selected ? Theme.primary : white;
                                        border-color: item.is_selected ? Theme.primary : Theme.border;
                                        border-width: 1px;
                                        border-radius: 4px;
                                        if item.is_selected: Text {
                                            text: "✓";
                                            color: white;
                                            font-size: 12px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Pos name & month
                                    Text {
                                        horizontal-stretch: 1;
                                        text: item.payment_type_name + (item.month_name != "" ? " (" + item.month_name + ")" : "");
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.text-main;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        width: 100px;
                                        text: item.amount;
                                        font-size: 13px;
                                        color: Theme.text-muted;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        width: 100px;
                                        text: item.remaining_amount;
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: item.remaining_raw > 0 ? Theme.rose : Theme.emerald;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }

                                    // Badge status
                                    Rectangle {
                                        width: 90px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: item.status == "lunas" ? Theme.emerald-light : item.status == "sebagian" ? Theme.amber-light : Theme.rose-light;
                                        Text {
                                            text: item.status == "lunas" ? "LUNAS" : item.status == "sebagian" ? "CICILAN" : "BELUM";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: item.status == "lunas" ? Theme.emerald : item.status == "sebagian" ? Theme.amber : Theme.rose;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                touch-item := TouchArea {
                                    enabled: item.remaining_raw > 0;
                                    clicked => { root.toggle-assignment-selection(item.id); }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                }
            }

            // Kanan: Panel Keranjang Pembayaran (Cart Panel)
            Rectangle {
                width: 360px;
                background: Theme.bg-card;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 10px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 14px;

                    // Header Keranjang
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: "🛒 Keranjang Bayar";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text-main;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    // List Cart Items
                    Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 8px;
                            for item in root.cart-items: Rectangle {
                                height: 50px;
                                background: Theme.bg-secondary;
                                border-radius: 6px;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: item.name;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: Theme.text-main;
                                        }
                                        Text {
                                            text: "Nominal: " + item.pay_amount_text;
                                            font-size: 11px;
                                            color: Theme.emerald;
                                            font-weight: 700;
                                        }
                                    }

                                    // Remove button
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        background: #fde8e8;
                                        border-radius: 12px;
                                        y: 13px;
                                        touch-del := TouchArea {
                                            clicked => { root.remove-cart-item(item.assignment_id); }
                                            mouse-cursor: pointer;
                                        }
                                        Text {
                                            text: "✕";
                                            color: Theme.rose;
                                            font-size: 11px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Total & Payment Methods
                    VerticalLayout {
                        spacing: 10px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Total Tagihan Dipilih:";
                                font-size: 13px;
                                color: Theme.text-muted;
                                font-weight: 600;
                            }
                            Text {
                                text: root.cart-total;
                                font-size: 18px;
                                color: Theme.primary;
                                font-weight: 800;
                            }
                        }

                        // Method selection tabs
                        HorizontalLayout {
                            spacing: 6px;
                            height: 34px;

                            Rectangle {
                                horizontal-stretch: 1;
                                background: root.selected-payment-method == 0 ? Theme.primary : Theme.bg-secondary;
                                border-radius: 6px;
                                TouchArea { clicked => { root.select-payment-method(0); } mouse-cursor: pointer; }
                                Text {
                                    text: "💵 Tunai";
                                    color: root.selected-payment-method == 0 ? white : Theme.text-main;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: root.selected-payment-method == 1 ? Theme.primary : Theme.bg-secondary;
                                border-radius: 6px;
                                TouchArea { clicked => { root.select-payment-method(1); } mouse-cursor: pointer; }
                                Text {
                                    text: "🏦 Transfer";
                                    color: root.selected-payment-method == 1 ? white : Theme.text-main;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: root.selected-payment-method == 2 ? Theme.primary : Theme.bg-secondary;
                                border-radius: 6px;
                                TouchArea { clicked => { root.select-payment-method(2); } mouse-cursor: pointer; }
                                Text {
                                    text: "💰 Tabungan";
                                    color: root.selected-payment-method == 2 ? white : Theme.text-main;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Pay Button
                        Rectangle {
                            height: 44px;
                            background: root.is-processing-payment ? #a0d4be : Theme.emerald;
                            border-radius: 8px;

                            TouchArea {
                                enabled: !root.is-processing-payment;
                                clicked => { root.process-payment-clicked(); }
                                mouse-cursor: pointer;
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text {
                                    text: root.is-processing-payment ? "Memproses..." : "PROSES PEMBAYARAN";
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: white;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // 4. Riwayat Transaksi Hari Ini (Bottom Section)
        Rectangle {
            height: 160px;
            background: Theme.bg-card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 10px;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "📋 Transaksi Kasir Hari Ini";
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.text-main;
                    }
                }

                Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        for tx in root.today-payments: Rectangle {
                            height: 36px;
                            background: Theme.bg-secondary;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;
                                alignment: center;

                                Text {
                                    width: 130px;
                                    text: tx.transaction_code;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.primary;
                                    vertical-alignment: center;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: tx.student_name;
                                    font-size: 12px;
                                    color: Theme.text-main;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: 100px;
                                    text: tx.payment_method;
                                    font-size: 12px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: 110px;
                                    text: tx.total_amount;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: Theme.emerald;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: 90px;
                                    text: tx.created_at;
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                // Tombol cetak ulang
                                Rectangle {
                                    width: 28px;
                                    height: 24px;
                                    background: Theme.primary-light;
                                    border-radius: 4px;
                                    TouchArea {
                                        clicked => { root.print-receipt-clicked(tx.transaction_code); }
                                        mouse-cursor: pointer;
                                    }
                                    Text {
                                        text: "🖨️";
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
