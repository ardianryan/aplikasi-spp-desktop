import { Theme } from "../theme.slint";

export struct StudentData {
    id: string,
    nis: string,
    nisn: string,
    nama: string,
    kelas: string,
    savings_balance: string,
}

export struct BillSummaryData {
    total_tagihan: string,
    total_dibayar: string,
    total_keringanan: string,
    total_tunggakan: string,
}

export struct AssignmentData {
    id: string,
    payment_type_name: string,
    payment_type_type: string,
    month_name: string,
    amount: string,
    paid_amount: string,
    remaining_amount: string,
    remaining_raw: int,
    status: string, // "lunas", "sebagian", "belum_bayar"
    is_selected: bool,
}

export struct CartItemData {
    assignment_id: string,
    name: string,
    remaining_text: string,
    pay_amount_text: string,
}

export struct TodayPaymentData {
    transaction_code: string,
    student_name: string,
    total_amount: string,
    payment_method: string,
    created_at: string,
}

// 4 Kartu Ringkasan (Professional Modern FinTech Card - No Emoji)
component SummaryCard inherits Rectangle {
    in property <string> title: "";
    in property <string> amount: "Rp 0";
    in property <color> card-color: Theme.primary;
    in property <color> card-light-color: Theme.primary-light;
    in property <image> icon-src: @image-url("../assets/icons/bill.svg");

    background: Theme.bg-card;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 8px;
    height: 76px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        alignment: start;

        Rectangle {
            width: 38px;
            height: 38px;
            background: root.card-light-color;
            border-radius: 8px;
            y: 18px;
            HorizontalLayout {
                alignment: center;
                Image {
                    source: root.icon-src;
                    width: 18px;
                    height: 18px;
                    image-fit: contain;
                    colorize: root.card-color;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text {
                text: root.title;
                font-size: 11px;
                color: Theme.text-muted;
                font-weight: 600;
            }
            Text {
                text: root.amount;
                font-size: 17px;
                color: root.card-color;
                font-weight: 800;
            }
        }
    }
}

export component PosView inherits Rectangle {
    background: Theme.bg-primary;

    in property <StudentData> current-student: {
        id: "",
        nis: "-",
        nisn: "-",
        nama: "Pilih / Cari Siswa Di Atas",
        kelas: "-",
        savings_balance: "Rp 0"
    };

    in property <BillSummaryData> summary: {
        total_tagihan: "Rp 0",
        total_dibayar: "Rp 0",
        total_keringanan: "Rp 0",
        total_tunggakan: "Rp 0"
    };

    in property <[AssignmentData]> assignments: [];
    in property <[CartItemData]> cart-items: [];
    in property <[TodayPaymentData]> today-payments: [];
    in property <string> cart-total: "Rp 0";
    in property <int> selected-payment-method: 0; // 0: Tunai, 1: Transfer, 2: Tabungan
    in property <bool> is-processing-payment: false;

    callback toggle-assignment-selection(string);
    callback remove-cart-item(string);
    callback select-payment-method(int);
    callback process-payment-clicked();
    callback print-receipt-clicked(string);

    VerticalLayout {
        padding: 16px;
        spacing: 14px;

        // 1. Info Bar Siswa Terpilih (Clean Corporate Style)
        Rectangle {
            height: 60px;
            background: Theme.bg-card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 8px;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        background: Theme.primary-light;
                        border-radius: 18px;
                        y: 12px;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/icons/student.svg");
                                width: 18px;
                                height: 18px;
                                image-fit: contain;
                                colorize: Theme.primary;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.current-student.nama;
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text-main;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "NIS: " + root.current-student.nis;
                                font-size: 12px;
                                color: Theme.text-muted;
                            }
                            Text {
                                text: "Kelas: " + root.current-student.kelas;
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.primary;
                            }
                        }
                    }
                }

                // Saldo Tabungan Badge (No Emoji)
                Rectangle {
                    height: 34px;
                    background: Theme.emerald-light;
                    border-color: #a7f3d0;
                    border-width: 1px;
                    border-radius: 6px;
                    y: 13px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: center;

                        Image {
                            source: @image-url("../assets/icons/savings.svg");
                            width: 14px;
                            height: 14px;
                            image-fit: contain;
                            colorize: Theme.emerald;
                        }

                        Text {
                            text: "Tabungan:";
                            font-size: 11px;
                            color: Theme.emerald-hover;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.current-student.savings_balance;
                            font-size: 13px;
                            font-weight: 800;
                            color: Theme.emerald;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // 2. 4 Summary Cards Grid (No Emoji)
        HorizontalLayout {
            spacing: 12px;
            SummaryCard {
                title: "Total Tagihan Siswa";
                amount: root.summary.total_tagihan;
                card-color: Theme.primary;
                card-light-color: Theme.primary-light;
                icon-src: @image-url("../assets/icons/bill.svg");
                horizontal-stretch: 1;
            }
            SummaryCard {
                title: "Sudah Dibayar";
                amount: root.summary.total_dibayar;
                card-color: Theme.emerald;
                card-light-color: Theme.emerald-light;
                icon-src: @image-url("../assets/icons/check.svg");
                horizontal-stretch: 1;
            }
            SummaryCard {
                title: "Keringanan (Relief)";
                amount: root.summary.total_keringanan;
                card-color: Theme.amber;
                card-light-color: Theme.amber-light;
                icon-src: @image-url("../assets/icons/bank.svg");
                horizontal-stretch: 1;
            }
            SummaryCard {
                title: "Tunggakan / Sisa";
                amount: root.summary.total_tunggakan;
                card-color: Theme.rose;
                card-light-color: Theme.rose-light;
                icon-src: @image-url("../assets/icons/bill.svg");
                horizontal-stretch: 1;
            }
        }

        // 3. Main Center Split: Tabel Tagihan (Kiri) & Keranjang Bayar (Kanan)
        HorizontalLayout {
            spacing: 14px;
            vertical-stretch: 1;

            // Kiri: Tabel Tagihan Siswa
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.bg-card;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 8px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    // Header Text
                    HorizontalLayout {
                        height: 24px;
                        alignment: space-between;
                        Text {
                            text: "Daftar Tagihan & Pos Biaya";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text-main;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Centang pos yang ingin dibayarkan kasir";
                            font-size: 11px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }

                    // Columns Header (Tetap di ATAS tabel)
                    Rectangle {
                        height: 36px;
                        background: Theme.bg-secondary;
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;
                            alignment: center;
                            Text { width: 36px; text: "Pilih"; font-size: 11px; font-weight: 700; color: Theme.text-muted; }
                            Text { horizontal-stretch: 1; text: "Nama Pos / Periode Bulan"; font-size: 11px; font-weight: 700; color: Theme.text-muted; }
                            Text { width: 110px; text: "Jumlah"; font-size: 11px; font-weight: 700; color: Theme.text-muted; horizontal-alignment: right; }
                            Text { width: 110px; text: "Sisa Bayar"; font-size: 11px; font-weight: 700; color: Theme.text-muted; horizontal-alignment: right; }
                            Text { width: 90px; text: "Status"; font-size: 11px; font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; }
                        }
                    }

                    // Content Rows / Empty State
                    if root.assignments.length == 0: Rectangle {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            HorizontalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../assets/icons/bill.svg");
                                    width: 32px;
                                    height: 32px;
                                    colorize: #cbd5e1;
                                }
                            }
                            Text {
                                text: "Belum ada tagihan dimuat. Silakan cari dan pilih siswa di kolom pencarian atas.";
                                font-size: 12px;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    if root.assignments.length > 0: Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            for item in root.assignments: Rectangle {
                                height: 42px;
                                background: item.is_selected ? #eff6ff : touch-item.has-hover ? #f8fafc : transparent;
                                border-color: item.is_selected ? Theme.primary : Theme.border-muted;
                                border-width: 1px;
                                border-radius: 6px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 8px;
                                    alignment: center;

                                    // Checkbox Kotak
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        background: item.is_selected ? Theme.primary : white;
                                        border-color: item.is_selected ? Theme.primary : Theme.border;
                                        border-width: 1px;
                                        border-radius: 4px;
                                        if item.is_selected: Image {
                                            source: @image-url("../assets/icons/check.svg");
                                            width: 12px;
                                            height: 12px;
                                            image-fit: contain;
                                        }
                                    }

                                    // Nama Pos
                                    Text {
                                        horizontal-stretch: 1;
                                        text: item.payment_type_name + (item.month_name != "" ? " (" + item.month_name + ")" : "");
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Theme.text-main;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        width: 110px;
                                        text: item.amount;
                                        font-size: 12px;
                                        color: Theme.text-muted;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        width: 110px;
                                        text: item.remaining_amount;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: item.remaining_raw > 0 ? Theme.rose : Theme.emerald;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }

                                    // Badge status
                                    Rectangle {
                                        width: 90px;
                                        height: 22px;
                                        border-radius: 11px;
                                        background: item.status == "lunas" ? Theme.emerald-light : item.status == "sebagian" ? Theme.amber-light : Theme.rose-light;
                                        Text {
                                            text: item.status == "lunas" ? "LUNAS" : item.status == "sebagian" ? "CICILAN" : "BELUM";
                                            font-size: 10px;
                                            font-weight: 700;
                                            color: item.status == "lunas" ? Theme.emerald : item.status == "sebagian" ? Theme.amber : Theme.rose;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                touch-item := TouchArea {
                                    enabled: item.remaining_raw > 0;
                                    clicked => { root.toggle-assignment-selection(item.id); }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                }
            }

            // Kanan: Panel Keranjang Pembayaran (Cart Panel - No Emoji)
            Rectangle {
                width: 350px;
                background: Theme.bg-card;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 8px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    // Header Keranjang
                    HorizontalLayout {
                        height: 24px;
                        spacing: 8px;
                        alignment: start;
                        Image {
                            source: @image-url("../assets/icons/cart.svg");
                            width: 16px;
                            height: 16px;
                            image-fit: contain;
                            colorize: Theme.primary;
                            y: 4px;
                        }
                        Text {
                            text: "Keranjang Pembayaran";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text-main;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    // Empty / List Cart Items
                    if root.cart-items.length == 0: Rectangle {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: "Keranjang masih kosong";
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Klik centang pada tagihan di sebelah kiri";
                                font-size: 11px;
                                color: #94a3b8;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    if root.cart-items.length > 0: Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            for item in root.cart-items: Rectangle {
                                height: 46px;
                                background: Theme.bg-secondary;
                                border-radius: 6px;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: item.name;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: Theme.text-main;
                                        }
                                        Text {
                                            text: "Bayar: " + item.pay_amount_text;
                                            font-size: 11px;
                                            color: Theme.emerald;
                                            font-weight: 700;
                                        }
                                    }

                                    // Tombol Hapus item dari cart
                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        background: #fee2e2;
                                        border-radius: 11px;
                                        y: 12px;
                                        HorizontalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("../assets/icons/close.svg");
                                                width: 10px;
                                                height: 10px;
                                                image-fit: contain;
                                            }
                                        }
                                        TouchArea {
                                            clicked => { root.remove-cart-item(item.assignment_id); }
                                            mouse-cursor: pointer;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Total & Pilihan Metode Pembayaran
                    VerticalLayout {
                        spacing: 10px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Total Tagihan Dipilih:";
                                font-size: 12px;
                                color: Theme.text-muted;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.cart-total;
                                font-size: 18px;
                                color: Theme.primary;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                        }

                        // Tab Pilihan Metode Bayar (No Emoji)
                        HorizontalLayout {
                            spacing: 6px;
                            height: 34px;

                            Rectangle {
                                horizontal-stretch: 1;
                                background: root.selected-payment-method == 0 ? Theme.primary : Theme.bg-secondary;
                                border-color: root.selected-payment-method == 0 ? Theme.primary : Theme.border;
                                border-width: 1px;
                                border-radius: 6px;
                                TouchArea { clicked => { root.select-payment-method(0); } mouse-cursor: pointer; }
                                Text {
                                    text: "Tunai";
                                    color: root.selected-payment-method == 0 ? white : Theme.text-main;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: root.selected-payment-method == 1 ? Theme.primary : Theme.bg-secondary;
                                border-color: root.selected-payment-method == 1 ? Theme.primary : Theme.border;
                                border-width: 1px;
                                border-radius: 6px;
                                TouchArea { clicked => { root.select-payment-method(1); } mouse-cursor: pointer; }
                                Text {
                                    text: "Transfer";
                                    color: root.selected-payment-method == 1 ? white : Theme.text-main;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: root.selected-payment-method == 2 ? Theme.primary : Theme.bg-secondary;
                                border-color: root.selected-payment-method == 2 ? Theme.primary : Theme.border;
                                border-width: 1px;
                                border-radius: 6px;
                                TouchArea { clicked => { root.select-payment-method(2); } mouse-cursor: pointer; }
                                Text {
                                    text: "Tabungan";
                                    color: root.selected-payment-method == 2 ? white : Theme.text-main;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Tombol Proses Pembayaran
                        Rectangle {
                            height: 42px;
                            background: root.is-processing-payment ? #94a3b8 : Theme.emerald;
                            border-radius: 6px;

                            TouchArea {
                                enabled: !root.is-processing-payment;
                                clicked => { root.process-payment-clicked(); }
                                mouse-cursor: pointer;
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text {
                                    text: root.is-processing-payment ? "Memproses Transaksi..." : "PROSES PEMBAYARAN";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: white;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // 4. Riwayat Transaksi Hari Ini (Bottom Section - Clean Corporate)
        Rectangle {
            height: 150px;
            background: Theme.bg-card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 8px;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    height: 20px;
                    spacing: 8px;
                    alignment: start;
                    Image {
                        source: @image-url("../assets/icons/history.svg");
                        width: 14px;
                        height: 14px;
                        image-fit: contain;
                        colorize: Theme.primary;
                        y: 3px;
                    }
                    Text {
                        text: "Transaksi Kasir Hari Ini";
                        font-size: 13px;
                        font-weight: 700;
                        color: Theme.text-main;
                        vertical-alignment: center;
                    }
                }

                if root.today-payments.length == 0: Rectangle {
                    vertical-stretch: 1;
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "Belum ada transaksi pembayaran yang dilakukan hari ini.";
                            font-size: 12px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.today-payments.length > 0: Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        for tx in root.today-payments: Rectangle {
                            height: 34px;
                            background: Theme.bg-secondary;
                            border-radius: 4px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;
                                alignment: center;

                                Text {
                                    width: 140px;
                                    text: tx.transaction_code;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: Theme.primary;
                                    vertical-alignment: center;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: tx.student_name;
                                    font-size: 11px;
                                    color: Theme.text-main;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: 90px;
                                    text: tx.payment_method;
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: 110px;
                                    text: tx.total_amount;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Theme.emerald;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: 80px;
                                    text: tx.created_at;
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                // Tombol Cetak Struk (Clean SVG Icon)
                                Rectangle {
                                    width: 26px;
                                    height: 24px;
                                    background: Theme.primary-light;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../assets/icons/print.svg");
                                            width: 13px;
                                            height: 13px;
                                            image-fit: contain;
                                            colorize: Theme.primary;
                                        }
                                    }
                                    TouchArea {
                                        clicked => { root.print-receipt-clicked(tx.transaction_code); }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
