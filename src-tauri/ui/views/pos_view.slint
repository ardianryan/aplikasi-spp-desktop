import { Theme } from "../theme.slint";

export struct StudentData {
    id: string,
    nis: string,
    nisn: string,
    nama: string,
    kelas: string,
    savings_balance: string,
}

export struct BillSummaryData {
    total_tagihan: string,
    total_dibayar: string,
    total_keringanan: string,
    total_tunggakan: string,
}

export struct AssignmentData {
    id: string,
    academic_year_name: string,
    payment_type_name: string,
    payment_type_type: string,
    month_name: string,
    amount: string,
    paid_amount: string,
    remaining_amount: string,
    remaining_raw: int,
    status: string, // "lunas", "sebagian", "belum_bayar"
    is_selected: bool,
    is_group_header: bool,
    group_header_title: string,
    is_active_year: bool,
    is_collapsed: bool,
    is_hidden: bool,
    total_bills_in_year: int,
    total_remaining_in_year: string,
}

export struct CartItemData {
    assignment_id: string,
    name: string,
    remaining_text: string,
    pay_amount_text: string,
}

export struct TodayPaymentData {
    transaction_code: string,
    student_name: string,
    total_amount: string,
    payment_method: string,
    created_at: string,
}

component SummaryCard inherits Rectangle {
    in property <string> title: "";
    in property <string> amount: "Rp 0";
    in property <color> card-color: Theme.primary;
    in property <color> card-light-color: Theme.primary-light;
    in property <image> icon-src: @image-url("../assets/icons/bill.svg");

    background: Theme.bg-card;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 8px;
    height: 72px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            width: 36px;
            Rectangle {
                width: 36px;
                height: 36px;
                background: root.card-light-color;
                border-radius: 8px;
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.icon-src;
                    width: 18px;
                    height: 18px;
                    image-fit: contain;
                    colorize: root.card-color;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 11px;
                color: Theme.text-muted;
                font-weight: 600;
            }
            Text {
                text: root.amount;
                font-size: 15px;
                color: root.card-color;
                font-weight: 800;
            }
        }
    }
}

export component PosView inherits Rectangle {
    background: Theme.bg-primary;

    in property <string> today-cashier-total: "Rp 0";
    in property <string> monthly-cashier-total: "Rp 0";
    in property <string> today-cashier-count: "0 Transaksi";

    in property <StudentData> current-student: {
        id: "",
        nis: "-",
        nisn: "-",
        nama: "",
        kelas: "-",
        savings_balance: "Rp 0"
    };

    in property <BillSummaryData> summary: {
        total_tagihan: "Rp 0",
        total_dibayar: "Rp 0",
        total_keringanan: "Rp 0",
        total_tunggakan: "Rp 0"
    };

    in property <[AssignmentData]> assignments: [];
    in property <[CartItemData]> cart-items: [];
    in property <[TodayPaymentData]> today-payments: [];
    in property <string> cart-total: "Rp 0";
    in property <int> selected-payment-method: 0; // 0: Tunai, 1: Transfer, 2: Tabungan
    in property <bool> is-processing-payment: false;
    in property <bool> savings-enabled: false;

    callback toggle-assignment-selection(string);
    callback remove-cart-item(string);
    callback select-payment-method(int);
    callback process-payment-clicked();
    callback print-receipt-clicked(string);
    callback clear-selected-student();
    callback toggle-year-collapse(string);

    VerticalLayout {
        padding: 16px;
        spacing: 14px;

        // 1. Top Kasir Metrics (Paritas React App.tsx)
        HorizontalLayout {
            spacing: 14px;
            height: 74px;

            SummaryCard {
                title: "Pemasukan Hari Ini";
                amount: root.today-cashier-total;
                card-color: #002b59; // Deep Navy
                card-light-color: #e0f2fe;
                icon-src: @image-url("../assets/icons/cash.svg");
                horizontal-stretch: 1;
            }

            SummaryCard {
                title: "Pemasukan Bulan Ini";
                amount: root.monthly-cashier-total;
                card-color: #008f5d; // Emerald
                card-light-color: #dcfce7;
                icon-src: @image-url("../assets/icons/bank.svg");
                horizontal-stretch: 1;
            }

            SummaryCard {
                title: "Transaksi Hari Ini";
                amount: root.today-cashier-count;
                card-color: #d97706; // Amber
                card-light-color: #fef3c7;
                icon-src: @image-url("../assets/icons/bill.svg");
                horizontal-stretch: 1;
            }
        }

        // 2. Main Center Split
        HorizontalLayout {
            spacing: 14px;
            vertical-stretch: 1;

            // KIRI: Welcome Banner ATAU Daftar Tagihan Siswa
            if root.current-student.id == "": Rectangle {
                horizontal-stretch: 1;
                background: @linear-gradient(135deg, #002b59 0%, #1a4175 100%);
                border-radius: 12px;

                VerticalLayout {
                    alignment: center;
                    spacing: 14px;
                    padding: 40px;

                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 56px;
                            height: 56px;
                            background: rgba(255, 255, 255, 0.15);
                            border-radius: 28px;
                            Image {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("../assets/icons/search.svg");
                                width: 28px;
                                height: 28px;
                                image-fit: contain;
                                colorize: white;
                            }
                        }
                    }

                    Text {
                        text: "Cari Data Siswa";
                        font-size: 20px;
                        font-weight: 700;
                        color: white;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Ketik nama, NIS, atau kelas pada kotak pencarian di bagian atas untuk memulai transaksi pembayaran kasir.";
                        font-size: 13px;
                        color: rgba(255, 255, 255, 0.85);
                        horizontal-alignment: center;
                    }
                }
            }

            if root.current-student.id != "": VerticalLayout {
                horizontal-stretch: 1;
                spacing: 10px;

                // Profile Bar Siswa Aktif
                Rectangle {
                    height: 56px;
                    background: Theme.bg-card;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 8px;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                width: 36px;
                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    background: Theme.primary-light;
                                    border-radius: 18px;
                                    Image {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        source: @image-url("../assets/icons/student.svg");
                                        width: 18px;
                                        height: 18px;
                                        image-fit: contain;
                                        colorize: Theme.primary;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: root.current-student.nama;
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: Theme.text-main;
                                }
                                Text {
                                    text: "NIS: " + root.current-student.nis + " | Kelas: " + root.current-student.kelas;
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 10px;

                                // Badge Saldo Tabungan
                                if root.savings-enabled: Rectangle {
                                    height: 32px;
                                    background: Theme.emerald-light;
                                    border-color: #a7f3d0;
                                    border-width: 1px;
                                    border-radius: 6px;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 6px;

                                        VerticalLayout {
                                            alignment: center;
                                            width: 14px;
                                            Image {
                                                source: @image-url("../assets/icons/savings.svg");
                                                width: 14px;
                                                height: 14px;
                                                image-fit: contain;
                                                colorize: Theme.emerald;
                                            }
                                        }

                                        Text {
                                            text: "Tabungan: " + root.current-student.savings_balance;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: Theme.emerald;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Tombol Ganti Siswa
                                Rectangle {
                                    height: 32px;
                                    background: #f1f5f9;
                                    border-color: #cbd5e1;
                                    border-width: 1px;
                                    border-radius: 6px;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 6px;

                                        VerticalLayout {
                                            alignment: center;
                                            width: 10px;
                                            Image {
                                                source: @image-url("../assets/icons/close.svg");
                                                width: 10px;
                                                height: 10px;
                                                image-fit: contain;
                                            }
                                        }

                                        Text {
                                            text: "Ganti Siswa";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: Theme.text-muted;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        clicked => { root.clear-selected-student(); }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }
                    }
                }

                // Tabel Tagihan Siswa
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.bg-card;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 8px;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        // Header Bar
                        HorizontalLayout {
                            height: 22px;
                            alignment: space-between;
                            Text {
                                text: "Daftar Tagihan & Pos Biaya";
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.text-main;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Centang pos yang ingin dibayarkan kasir";
                                font-size: 11px;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }
                        }

                        // Table Columns Header
                        Rectangle {
                            height: 34px;
                            background: Theme.bg-secondary;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                Text { width: 32px; text: "Pilih"; font-size: 11px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                                Text { horizontal-stretch: 1; text: "Nama Pos / Periode Bulan"; font-size: 11px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                                Text { width: 90px; text: "Jumlah"; font-size: 11px; font-weight: 700; color: Theme.text-muted; horizontal-alignment: right; vertical-alignment: center; }
                                Text { width: 90px; text: "Sisa Bayar"; font-size: 11px; font-weight: 700; color: Theme.text-muted; horizontal-alignment: right; vertical-alignment: center; }
                                Text { width: 75px; text: "Status"; font-size: 11px; font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }

                        // Table Rows
                        if root.assignments.length == 0: Rectangle {
                            vertical-stretch: 1;
                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: "Tidak ada tagihan yang di-assign untuk siswa ini.";
                                    font-size: 12px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if root.assignments.length > 0: Flickable {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                spacing: 4px;
                                for item in root.assignments: Rectangle {
                                    visible: !item.is_hidden;
                                    height: item.is_hidden ? 0px : item.is_group_header ? 38px : 40px;
                                    background: item.is_group_header ? (touch-row.has-hover ? #dbeafe : item.is_active_year ? #eff6ff : #f8fafc) : item.is_selected ? #eff6ff : touch-row.has-hover ? #f8fafc : transparent;
                                    border-color: item.is_group_header ? (item.is_active_year ? #bfdbfe : #e2e8f0) : item.is_selected ? Theme.primary : Theme.border-muted;
                                    border-width: 1px;
                                    border-radius: 6px;
                                    animate background { duration: 150ms; }

                                    touch-row := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if item.is_group_header {
                                                root.toggle-year-collapse(item.academic_year_name);
                                            } else if item.remaining_raw > 0 {
                                                root.toggle-assignment-selection(item.id);
                                            }
                                        }
                                    }

                                    if item.is_group_header && !item.is_hidden: HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        alignment: space-between;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            VerticalLayout {
                                                alignment: center;
                                                width: 16px;
                                                Image {
                                                    source: @image-url("../assets/icons/bill.svg");
                                                    width: 14px;
                                                    height: 14px;
                                                    image-fit: contain;
                                                    colorize: item.is_active_year ? Theme.primary : Theme.text-muted;
                                                }
                                            }
                                            Text {
                                                text: item.group_header_title;
                                                font-size: 12px;
                                                font-weight: 800;
                                                color: item.is_active_year ? Theme.primary : Theme.text-main;
                                                vertical-alignment: center;
                                            }
                                            if item.is_active_year: Rectangle {
                                                height: 20px;
                                                border-radius: 10px;
                                                background: #dbeafe;
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    Text {
                                                        text: "Aktif";
                                                        font-size: 10px;
                                                        font-weight: 700;
                                                        color: Theme.primary;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 12px;
                                            if item.total_remaining_in_year != "": Text {
                                                text: item.total_remaining_in_year;
                                                font-size: 11px;
                                                font-weight: 600;
                                                color: Theme.text-muted;
                                                vertical-alignment: center;
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                width: 18px;
                                                Image {
                                                    source: item.is_collapsed ? @image-url("../assets/icons/chevron-right.svg") : @image-url("../assets/icons/chevron-down.svg");
                                                    width: 13px;
                                                    height: 13px;
                                                    image-fit: contain;
                                                    colorize: item.is_active_year ? Theme.primary : Theme.text-muted;
                                                }
                                            }
                                        }
                                    }

                                    if !item.is_group_header && !item.is_hidden: HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;

                                        VerticalLayout {
                                            alignment: center;
                                            width: 20px;
                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                background: item.is_selected ? Theme.primary : white;
                                                border-color: item.is_selected ? Theme.primary : Theme.border;
                                                border-width: 1px;
                                                border-radius: 4px;
                                                if item.is_selected: Image {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    source: @image-url("../assets/icons/check.svg");
                                                    width: 12px;
                                                    height: 12px;
                                                    image-fit: contain;
                                                }
                                            }
                                        }

                                        Text {
                                            horizontal-stretch: 1;
                                            text: item.payment_type_name + (item.month_name != "" ? " (" + item.month_name + ")" : "");
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: Theme.text-main;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            width: 90px;
                                            text: item.amount;
                                            font-size: 12px;
                                            color: Theme.text-muted;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            width: 90px;
                                            text: item.remaining_amount;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: item.remaining_raw > 0 ? Theme.rose : Theme.emerald;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            width: 75px;
                                            Rectangle {
                                                width: 75px;
                                                height: 20px;
                                                border-radius: 10px;
                                                background: item.status == "lunas" ? Theme.emerald-light : item.status == "sebagian" ? Theme.amber-light : Theme.rose-light;
                                                Text {
                                                    text: item.status == "lunas" ? "LUNAS" : item.status == "sebagian" ? "CICILAN" : "BELUM";
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    color: item.status == "lunas" ? Theme.emerald : item.status == "sebagian" ? Theme.amber : Theme.rose;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // KANAN: Petunjuk Pintasan (Jika siswa belum dipilih) ATAU Keranjang Bayar
            if root.current-student.id == "": Rectangle {
                width: 290px;
                background: Theme.bg-card;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 8px;

                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;

                    HorizontalLayout {
                        spacing: 10px;
                        height: 24px;
                        VerticalLayout {
                            alignment: center;
                            width: 18px;
                            Image {
                                source: @image-url("../assets/icons/monitor.svg");
                                width: 18px;
                                height: 18px;
                                image-fit: contain;
                                colorize: Theme.primary;
                            }
                        }
                        Text {
                            text: "Petunjuk Pintasan Kasir";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text-main;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    Rectangle {
                        background: #f0fdf4;
                        border-color: #bbf7d0;
                        border-width: 1px;
                        border-radius: 8px;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;
                            Text {
                                text: "Mode Kasir Offline Standalone";
                                font-size: 12px;
                                font-weight: 700;
                                color: Theme.emerald;
                            }
                            Text {
                                text: "Aplikasi siap memproses pembayaran tanpa ketergantungan koneksi internet.";
                                font-size: 11px;
                                color: #166534;
                                wrap: word-wrap;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: "Alur Pembayaran Kasir:";
                            font-size: 12px;
                            font-weight: 700;
                            color: Theme.text-main;
                        }
                        Text {
                            text: "1. Ketik nama atau NIS siswa pada kolom pencarian di header atas.";
                            font-size: 12px;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "2. Pilih siswa dari daftar hasil pencarian.";
                            font-size: 12px;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "3. Centang tagihan yang akan dibayarkan.";
                            font-size: 12px;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "4. Tentukan metode bayar (Tunai, Transfer, Tabungan) lalu klik Proses.";
                            font-size: 12px;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "5. Lakukan sinkronisasi data secara berkala ke database online.";
                            font-size: 12px;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if root.current-student.id != "": Rectangle {
                width: 290px;
                background: Theme.bg-card;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 8px;

                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    HorizontalLayout {
                        height: 24px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            width: 16px;
                            Image {
                                source: @image-url("../assets/icons/cart.svg");
                                width: 16px;
                                height: 16px;
                                image-fit: contain;
                                colorize: Theme.primary;
                            }
                        }
                        Text {
                            text: "Keranjang Pembayaran";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text-main;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    // Empty / List Cart Items
                    if root.cart-items.length == 0: Rectangle {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: "Keranjang masih kosong";
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Centang pos tagihan di sebelah kiri";
                                font-size: 11px;
                                color: #94a3b8;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    if root.cart-items.length > 0: Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            for item in root.cart-items: Rectangle {
                                height: 44px;
                                background: Theme.bg-secondary;
                                border-radius: 6px;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: item.name;
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: Theme.text-main;
                                        }
                                        Text {
                                            text: "Bayar: " + item.pay_amount_text;
                                            font-size: 11px;
                                            color: Theme.emerald;
                                            font-weight: 700;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        width: 22px;
                                        Rectangle {
                                            width: 22px;
                                            height: 22px;
                                            background: #fee2e2;
                                            border-radius: 11px;
                                            Image {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                source: @image-url("../assets/icons/close.svg");
                                                width: 10px;
                                                height: 10px;
                                                image-fit: contain;
                                            }
                                            TouchArea {
                                                clicked => { root.remove-cart-item(item.assignment_id); }
                                                mouse-cursor: pointer;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Total & Pilihan Metode Pembayaran
                    VerticalLayout {
                        spacing: 10px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Total Tagihan Dipilih:";
                                font-size: 12px;
                                color: Theme.text-muted;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.cart-total;
                                font-size: 17px;
                                color: Theme.primary;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                        }

                        // Tab Pilihan Metode Bayar
                        HorizontalLayout {
                            spacing: 6px;
                            height: 32px;

                            Rectangle {
                                horizontal-stretch: 1;
                                background: root.selected-payment-method == 0 ? Theme.primary : Theme.bg-secondary;
                                border-color: root.selected-payment-method == 0 ? Theme.primary : Theme.border;
                                border-width: 1px;
                                border-radius: 6px;
                                TouchArea { clicked => { root.select-payment-method(0); } mouse-cursor: pointer; }
                                Text {
                                    text: "Tunai";
                                    color: root.selected-payment-method == 0 ? white : Theme.text-main;
                                    font-size: 11px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: root.selected-payment-method == 1 ? Theme.primary : Theme.bg-secondary;
                                border-color: root.selected-payment-method == 1 ? Theme.primary : Theme.border;
                                border-width: 1px;
                                border-radius: 6px;
                                TouchArea { clicked => { root.select-payment-method(1); } mouse-cursor: pointer; }
                                Text {
                                    text: "Transfer";
                                    color: root.selected-payment-method == 1 ? white : Theme.text-main;
                                    font-size: 11px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            if root.savings-enabled: Rectangle {
                                horizontal-stretch: 1;
                                background: root.selected-payment-method == 2 ? Theme.primary : Theme.bg-secondary;
                                border-color: root.selected-payment-method == 2 ? Theme.primary : Theme.border;
                                border-width: 1px;
                                border-radius: 6px;
                                TouchArea { clicked => { root.select-payment-method(2); } mouse-cursor: pointer; }
                                Text {
                                    text: "Tabungan";
                                    color: root.selected-payment-method == 2 ? white : Theme.text-main;
                                    font-size: 11px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Tombol Proses Pembayaran
                        Rectangle {
                            height: 40px;
                            background: root.is-processing-payment ? #94a3b8 : Theme.emerald;
                            border-radius: 6px;

                            TouchArea {
                                enabled: !root.is-processing-payment;
                                clicked => { root.process-payment-clicked(); }
                                mouse-cursor: pointer;
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text {
                                    text: root.is-processing-payment ? "Memproses Transaksi..." : "PROSES PEMBAYARAN";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: white;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // 3. Riwayat Transaksi Kasir Hari Ini
        Rectangle {
            height: 220px;
            background: Theme.bg-card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 8px;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    height: 22px;
                    spacing: 8px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        width: 16px;
                        Image {
                            source: @image-url("../assets/icons/history.svg");
                            width: 14px;
                            height: 14px;
                            image-fit: contain;
                            colorize: Theme.primary;
                        }
                    }
                    Text {
                        text: "Transaksi Kasir Hari Ini";
                        font-size: 12px;
                        font-weight: 700;
                        color: Theme.text-main;
                        vertical-alignment: center;
                    }
                }

                // Table Columns Header
                Rectangle {
                    height: 26px;
                    background: Theme.bg-secondary;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        Text { width: 140px; text: "No. Transaksi"; font-size: 10px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Nama Siswa"; font-size: 10px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                        Text { width: 80px; text: "Metode"; font-size: 10px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                        Text { width: 110px; text: "Total"; font-size: 10px; font-weight: 700; color: Theme.text-muted; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 70px; text: "Waktu"; font-size: 10px; font-weight: 700; color: Theme.text-muted; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 50px; text: "Aksi"; font-size: 10px; font-weight: 700; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                if root.today-payments.length == 0: Rectangle {
                    vertical-stretch: 1;
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "Belum ada transaksi pembayaran yang dilakukan hari ini.";
                            font-size: 11px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.today-payments.length > 0: Flickable {
                    vertical-stretch: 1;
                    content-height: root.today-payments.length * 36px;
                    VerticalLayout {
                        alignment: start;
                        spacing: 4px;
                        for tx in root.today-payments: Rectangle {
                            height: 32px;
                            background: Theme.bg-secondary;
                            border-radius: 4px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;

                                Text {
                                    width: 140px;
                                    text: tx.transaction_code;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: Theme.primary;
                                    vertical-alignment: center;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: tx.student_name;
                                    font-size: 11px;
                                    color: Theme.text-main;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: 80px;
                                    text: tx.payment_method;
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: 110px;
                                    text: tx.total_amount;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Theme.emerald;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: 70px;
                                    text: tx.created_at;
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    width: 50px;
                                    Rectangle {
                                        width: 48px;
                                        height: 24px;
                                        background: touch-today-p.has-hover ? #dbeafe : Theme.primary-light;
                                        border-radius: 4px;
                                        animate background { duration: 150ms; }
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            VerticalLayout {
                                                alignment: center;
                                                width: 11px;
                                                Image {
                                                    source: @image-url("../assets/icons/print.svg");
                                                    width: 11px;
                                                    height: 11px;
                                                    image-fit: contain;
                                                    colorize: Theme.primary;
                                                }
                                            }
                                            Text {
                                                text: "Cetak";
                                                font-size: 10px;
                                                font-weight: 600;
                                                color: Theme.primary;
                                                vertical-alignment: center;
                                            }
                                        }
                                        touch-today-p := TouchArea {
                                            clicked => { root.print-receipt-clicked(tx.transaction_code); }
                                            mouse-cursor: pointer;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
