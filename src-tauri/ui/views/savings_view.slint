import { Theme } from "../theme.slint";

export struct SavingsHistoryData {
    id: string,
    transaction_type: string, // "deposit" | "withdraw"
    amount: string,
    balance_after: string,
    notes: string,
    date: string,
}

export component SavingsView inherits Rectangle {
    background: Theme.bg-primary;

    in property <string> student-name: "Pilih Siswa di Pencarian Atas";
    in property <string> student-class: "-";
    in property <string> current-balance: "Rp 0";
    in-out property <string> input-amount: "";
    in-out property <string> input-notes: "";
    in property <[SavingsHistoryData]> history: [];
    in property <bool> is-processing: false;

    callback deposit-clicked(string, string);
    callback withdraw-clicked(string, string);

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        Text {
            text: "Tabungan Siswa";
            font-size: 20px;
            font-weight: 700;
            color: Theme.text-main;
        }

        // Kartu Saldo Tabungan
        Rectangle {
            height: 100px;
            background: Theme.bg-card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 10px;

            HorizontalLayout {
                padding: 20px;
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text {
                        text: "Siswa: " + root.student-name + " (" + root.student-class + ")";
                        font-size: 14px;
                        color: Theme.text-muted;
                    }
                    Text {
                        text: "Saldo Tersimpan";
                        font-size: 12px;
                        color: Theme.text-muted;
                    }
                }

                Text {
                    text: root.current-balance;
                    font-size: 28px;
                    font-weight: 800;
                    color: Theme.emerald;
                    vertical-alignment: center;
                }
            }
        }

        // Form Setor & Tarik
        Rectangle {
            height: 140px;
            background: Theme.bg-card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 10px;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: "Form Transaksi Tabungan";
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.text-main;
                }

                HorizontalLayout {
                    spacing: 12px;

                    // Input Nominal
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 40px;
                        background: Theme.bg-primary;
                        border-color: Theme.border;
                        border-width: 1px;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            TextInput {
                                text <=> root.input-amount;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Input Catatan
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 40px;
                        background: Theme.bg-primary;
                        border-color: Theme.border;
                        border-width: 1px;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            TextInput {
                                text <=> root.input-notes;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Tombol Setor
                    Rectangle {
                        width: 120px;
                        height: 40px;
                        background: Theme.emerald;
                        border-radius: 6px;
                        TouchArea {
                            enabled: !root.is-processing;
                            clicked => { root.deposit-clicked(root.input-amount, root.input-notes); }
                            mouse-cursor: pointer;
                        }
                        Text {
                            text: "+ Setor";
                            color: white;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Tombol Tarik
                    Rectangle {
                        width: 120px;
                        height: 40px;
                        background: Theme.rose;
                        border-radius: 6px;
                        TouchArea {
                            enabled: !root.is-processing;
                            clicked => { root.withdraw-clicked(root.input-amount, root.input-notes); }
                            mouse-cursor: pointer;
                        }
                        Text {
                            text: "- Tarik Tunai";
                            color: white;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Tabel Riwayat Tabungan
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 10px;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Text {
                    text: "Mutasi Tabungan Terakhir";
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.text-main;
                }

                Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        for mut in root.history: Rectangle {
                            height: 38px;
                            background: Theme.bg-secondary;
                            border-radius: 6px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                alignment: space-between;

                                Text {
                                    text: mut.transaction-type == "deposit" ? "📥 Setor" : "📤 Tarik";
                                    color: mut.transaction-type == "deposit" ? Theme.emerald : Theme.rose;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: mut.amount;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: Theme.text-main;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "Saldo: " + mut.balance-after;
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: mut.notes;
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: mut.date;
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
