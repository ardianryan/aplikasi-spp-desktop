import { Theme } from "../theme.slint";

export component SyncView inherits Rectangle {
    background: Theme.bg-primary;

    in-out property <string> base-url: "https://";
    in-out property <string> api-token: "";
    in property <string> last-sync-time: "Belum pernah sinkron";
    in property <string> pending-records-count: "0";
    in property <string> sync-message: "";
    in property <bool> is-syncing: false;
    in property <bool> is-testing: false;
    in property <string> test-result: "";

    callback test-connection-clicked(string, string);
    callback save-settings-clicked(string, string);
    callback trigger-sync-clicked();

    VerticalLayout {
        padding: 16px;
        spacing: 14px;

        HorizontalLayout {
            height: 28px;
            spacing: 8px;
            alignment: start;
            Image {
                source: @image-url("../assets/icons/sync.svg");
                width: 18px;
                height: 18px;
                image-fit: contain;
                colorize: Theme.primary;
                y: 5px;
            }
            Text {
                text: "Pengaturan & Sinkronisasi Server Pusat";
                font-size: 18px;
                font-weight: 700;
                color: Theme.text-main;
                vertical-alignment: center;
            }
        }

        // Form Pengaturan Koneksi Server
        Rectangle {
            height: 240px;
            background: Theme.bg-card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 8px;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: "Konfigurasi Peladen Cloud";
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.text-main;
                }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "URL Server API:"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                    Rectangle {
                        height: 38px;
                        background: Theme.bg-primary;
                        border-color: Theme.border;
                        border-width: 1px;
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            TextInput {
                                text <=> root.base-url;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Token Akses Kasir / Kunci Pairing:"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                    Rectangle {
                        height: 38px;
                        background: Theme.bg-primary;
                        border-color: Theme.border;
                        border-width: 1px;
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            TextInput {
                                text <=> root.api-token;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Rectangle {
                        width: 120px;
                        height: 36px;
                        background: Theme.primary-light;
                        border-radius: 6px;
                        TouchArea {
                            enabled: !root.is-testing;
                            clicked => { root.test-connection-clicked(root.base-url, root.api-token); }
                            mouse-cursor: pointer;
                        }
                        Text {
                            text: root.is-testing ? "Menguji..." : "Uji Koneksi";
                            color: Theme.on-primary-light;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 140px;
                        height: 36px;
                        background: Theme.primary;
                        border-radius: 6px;
                        TouchArea {
                            clicked => { root.save-settings-clicked(root.base-url, root.api-token); }
                            mouse-cursor: pointer;
                        }
                        Text {
                            text: "Simpan Pengaturan";
                            color: white;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if root.test-result != "": Text {
                        text: root.test-result;
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.emerald;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Status Antrean Failover
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 8px;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: "Status Sinkronisasi & Antrean Data Offline";
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.text-main;
                }

                HorizontalLayout {
                    spacing: 12px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 68px;
                        background: Theme.bg-secondary;
                        border-radius: 6px;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            Text { text: "Antrean Belum Terkirim (Pending Push):"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                            Text { text: root.pending-records-count + " Catatan Transaksi"; font-size: 16px; font-weight: 800; color: root.pending-records-count == "0" ? Theme.emerald : Theme.rose; }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 68px;
                        background: Theme.bg-secondary;
                        border-radius: 6px;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            Text { text: "Sinkronisasi Terakhir:"; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                            Text { text: root.last-sync-time; font-size: 14px; font-weight: 700; color: Theme.primary; }
                        }
                    }
                }

                if root.sync-message != "": Rectangle {
                    height: 38px;
                    background: Theme.primary-light;
                    border-radius: 6px;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Text {
                            text: root.sync-message;
                            font-size: 12px;
                            font-weight: 600;
                            color: Theme.on-primary-light;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    width: 200px;
                    height: 40px;
                    background: root.is-syncing ? #94a3b8 : Theme.emerald;
                    border-radius: 6px;
                    TouchArea {
                        enabled: !root.is-syncing;
                        clicked => { root.trigger-sync-clicked(); }
                        mouse-cursor: pointer;
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Image {
                            source: @image-url("../assets/icons/sync.svg");
                            width: 14px;
                            height: 14px;
                            image-fit: contain;
                        }
                        Text {
                            text: root.is-syncing ? "Sinkronisasi..." : "Sinkronkan Sekarang";
                            color: white;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }
            }
        }
    }
}
